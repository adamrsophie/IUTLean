import IUT.PaperIV.LocalFields.TensorLogShell
import IUT.PaperIV.LocalFields.TensorIndex
import IUT.PaperIV.LocalFields.UnitVolume

/-!
# Additivity of the log-volume over two tensor factors (IUT IV, page 14)

IUT IV (April 2020 manuscript), pages 10, 13 and 14; all three checked against renders. Page 10
defines `log_p(R_I^×)` as the tensor product over `ℤ_p` of the `log_p(R_i^×)`; page 13 states
Proposition 1.4; page 14 proves the first inequality of (iii) by the chain

    μ^log(p^{⌊λ − 𝔡_I − a_I⌋} · log_p(R_I^×))
      ≤ (−λ + 𝔡_I + a_I + 1)·log(p) + μ^log(log_p(R_I^×))
      = (−λ + 𝔡_I + a_I + 1)·log(p) + {∑_{i∈I} μ^log(log_p(R_i^×))} + μ^log(R_I)
      ≤ {−λ + 𝔡_I + 1 + ∑_{i∈I} (a_i − 1/e_i)}·log(p)
      ≤ (−λ + 𝔡_I + 1 + 4·|I*|/p)·log(p),

whose second line is the identity (A)
`μ^log(log_p(R_I^×)) = ∑_{i∈I} μ^log(log_p(R_i^×)) + μ^log(R_I)`. The page gives no proof of
(A). This module proves it for two factors and with it the first inequality of (iii) for two
factors without the restriction `e_i ≤ p − 2` of `tensorLog_prop1_4_iii_lattice`.

## Main results

* `tensorAdd_relIndex`: for `ℤ_p`-submodules `L₁ ≤ M₁` of `K₁` and `L₂ ≤ M₂` of `K₂`, with `M₁`
  and `L₂` finitely generated and spanning over `ℚ_p`, the image of `L₁ ⊗_{ℤ_p} L₂` in
  `K₁ ⊗[ℚ_p] K₂` has relative index `[M₁ : L₁] ^ d₂ · [M₂ : L₂] ^ d₁` in the image of
  `M₁ ⊗_{ℤ_p} M₂` (`dᵢ = [Kᵢ : ℚ_p]`). The statement behind (A); not printed on the pages.
* `tensorAdd_muLog_add`: (A) for full lattices `p ^ kᵢ Rᵢ ⊆ Lᵢ ⊆ p ^ (−kᵢ) Rᵢ`:
  `μ^log(L₁ ⊗ L₂) = μ^log(L₁) + μ^log(L₂) + μ^log(R₁ ⊗ R₂)`.
* `tensorAdd_muLog_logLattice`: (A) for `Lᵢ = log_p(Rᵢ^×)`, with `tensorLogLattice` on the left.
* `tensorAdd_prop1_4_iii_lattice`: the first inequality of Proposition 1.4 (iii) for two
  factors, for every `I*` with `e_i ≤ p − 2` for `i ∉ I*`; the statement of
  `tensorLog_prop1_4_iii_lattice` with its hypotheses `p > 2`, `e_1, e_2 ≤ p − 2` replaced by the
  hypothesis on `I*` printed on page 13 (the one of `tensorLog_prop1_4_iii_shift`).

## Conventions

The images of tensor products of lattices are the additive subgroups `tensorAddSpan A B` of
`K₁ ⊗[ℚ_p] K₂` generated by the `a · (x ⊗ y)`, `a ∈ ℤ_p`, `x ∈ A`, `y ∈ B`; for the logarithms of
the units this is `tensorLogLattice` (`tensorAddSpan_logUnits`), for the rings of integers it is
`R_E = padicPacketIntegers` (`tensorAddSpan_integers`). The log-volume of `K₁ ⊗ K₂` is
`padicPacketMuLog` normalized by `μ^log((R_E)^∼) = 0` for any Haar measure in coordinates, as in
`TensorLogShell` and `TensorIndex`; that of one factor is `tensorAddMuLog` (spectral norm, Borel
sets, `Measure.addHaar`, normalized by `μ^log(Rᵢ) = 0`), whose values do not depend on the Haar
measure (`padicMuLog_haar_indep`). The proof of (A): `p ^ (k₁ + k₂) R_E` is the image of
`p ^ k₁ R₁ ⊗ p ^ k₂ R₂`; its index in the image of `L₁ ⊗ L₂` is given by `tensorAdd_relIndex`,
computed in two steps `C₁ ⊗ C₂ ≤ L₁ ⊗ C₂ ≤ L₁ ⊗ L₂` through `ℚ_p`-bases of `K₂` and `K₁` that are
`ℤ_p`-bases of `C₂` and `L₁` (`tensorAdd_exists_basis`); Haar measure multiplies by the index.
That `log_p(R^×)` is a `ℤ_p`-lattice between `p ^ k R` and `p ^ (−k) R` is
`tensorAddLogSubmodule` and `tensorAdd_logUnits_sandwich`.

## Not proved

* More than two factors (the induction on `|I|`), here; every statement here is for
  `I = {1, 2}`. The additivity and the first inequality of Proposition 1.4 (iii) for any finite
  number of factors are in `IUT.PaperIV.LocalFields.TensorAdditivityMany`.
* The injectivity of `log_p(R_1^×) ⊗_{ℤ_p} log_p(R_2^×)` into `K₁ ⊗[ℚ_p] K₂`, as in
  `TensorLogShell`: the lattices are taken as their images.
* The multiplicativity of the index of `R_E` in `(R_E)^∼` left open by `Packets`: its "Not
  proved" list gives no statement of it, so none is attempted.
* The identification of `μ^log` with the log-volumes of `AbsTopIII` (as in `TensorLogShell`).
-/

open MeasureTheory IUT.Prerequisites.PadicVolume
open scoped Pointwise

namespace IUT.PaperIV.LocalFields

/-! ## The `ℤ_p`-span of the pure tensors -/

section Span

variable (p : ℕ) [hp : Fact p.Prime] (K₁ K₂ : Type*) [Field K₁] [Field K₂] [Algebra ℚ_[p] K₁]
  [Algebra ℚ_[p] K₂]

/-- **The image of `A ⊗_{ℤ_p} B` in `K₁ ⊗[ℚ_p] K₂`** for subsets `A ⊆ K₁`, `B ⊆ K₂`: the additive
subgroup generated by the `a · (x ⊗ y)` with `a ∈ ℤ_p`, `x ∈ A`, `y ∈ B`. For `A`, `B` the
images of `log_p` on the unit groups it is `tensorLogLattice` (`tensorAddSpan_logUnits`); for `A`,
`B` the rings of integers it is `R_E` (`tensorAddSpan_integers`). -/
noncomputable def tensorAddSpan (A : Set K₁) (B : Set K₂) :
    AddSubgroup (TensorProduct ℚ_[p] K₁ K₂) :=
  AddSubgroup.closure {w | ∃ (a : ℤ_[p]) (x : K₁) (y : K₂), x ∈ A ∧ y ∈ B ∧
    w = (a : ℚ_[p]) • TensorProduct.tmul ℚ_[p] x y}

/-- The carrier of `tensorAddSpan` is the additive submonoid generated by the same elements (the
generating set is closed under negation). -/
theorem tensorAddSpan_coe (A : Set K₁) (B : Set K₂) :
    (tensorAddSpan p K₁ K₂ A B : Set (TensorProduct ℚ_[p] K₁ K₂)) =
      ((AddSubmonoid.closure {w | ∃ (a : ℤ_[p]) (x : K₁) (y : K₂), x ∈ A ∧ y ∈ B ∧
        w = (a : ℚ_[p]) • TensorProduct.tmul ℚ_[p] x y} :
          AddSubmonoid (TensorProduct ℚ_[p] K₁ K₂)) : Set (TensorProduct ℚ_[p] K₁ K₂)) := by
  rw [← AddSubgroup.coe_toAddSubmonoid, tensorAddSpan, AddSubgroup.closure_toAddSubmonoid]
  congr 2
  refine Set.union_eq_left.2 ?_
  intro w hw
  obtain ⟨a, x, y, hx, hy, hw⟩ := Set.mem_neg.1 hw
  refine ⟨-a, x, y, hx, hy, ?_⟩
  rw [PadicInt.coe_neg, neg_smul, ← hw, neg_neg]

/-- `tensorAddSpan` is monotone in both arguments. -/
theorem tensorAddSpan_mono {A A' : Set K₁} {B B' : Set K₂} (hA : A ⊆ A') (hB : B ⊆ B') :
    tensorAddSpan p K₁ K₂ A B ≤ tensorAddSpan p K₁ K₂ A' B' := by
  refine AddSubgroup.closure_mono ?_
  rintro _ ⟨a, x, y, hx, hy, rfl⟩
  exact ⟨a, x, y, hA hx, hB hy, rfl⟩

/-- Exchanging the factors: the image of `tensorAddSpan B A` under `K₂ ⊗ K₁ ≃ K₁ ⊗ K₂` is
`tensorAddSpan A B`. -/
theorem tensorAddSpan_map_comm (A : Set K₁) (B : Set K₂) :
    (tensorAddSpan p K₂ K₁ B A).map
        (TensorProduct.comm ℚ_[p] K₂ K₁).toLinearMap.toAddMonoidHom =
      tensorAddSpan p K₁ K₂ A B := by
  rw [tensorAddSpan, tensorAddSpan, AddMonoidHom.map_closure]
  congr 1
  ext w
  constructor
  · rintro ⟨_, ⟨a, y, x, hy, hx, rfl⟩, rfl⟩
    exact ⟨a, x, y, hx, hy, by simp⟩
  · rintro ⟨a, x, y, hx, hy, rfl⟩
    exact ⟨_, ⟨a, y, x, hy, hx, rfl⟩, by simp⟩

/-- **Scaling the factors**: `(a A) ⊗ (b B) = (a b) · (A ⊗ B)` for `a`, `b ∈ ℚ_p`. -/
theorem tensorAddSpan_smul (a b : ℚ_[p]) (A : Set K₁) (B : Set K₂) :
    (tensorAddSpan p K₁ K₂ (a • A) (b • B) : Set (TensorProduct ℚ_[p] K₁ K₂)) =
      (a * b) • (tensorAddSpan p K₁ K₂ A B : Set (TensorProduct ℚ_[p] K₁ K₂)) := by
  have h : tensorAddSpan p K₁ K₂ (a • A) (b • B) = (tensorAddSpan p K₁ K₂ A B).map
      (DistribSMul.toAddMonoidHom (TensorProduct ℚ_[p] K₁ K₂) (a * b)) := by
    rw [tensorAddSpan, tensorAddSpan, AddMonoidHom.map_closure]
    congr 1
    ext w
    constructor
    · rintro ⟨c, _, _, ⟨x, hx, rfl⟩, ⟨y, hy, rfl⟩, rfl⟩
      refine ⟨_, ⟨c, x, y, hx, hy, rfl⟩, ?_⟩
      simp only [DistribSMul.toAddMonoidHom_apply, TensorProduct.smul_tmul_smul, smul_smul]
      ring_nf
    · rintro ⟨_, ⟨c, x, y, hx, hy, rfl⟩, rfl⟩
      refine ⟨c, a • x, b • y, Set.smul_mem_smul_set hx, Set.smul_mem_smul_set hy, ?_⟩
      simp only [DistribSMul.toAddMonoidHom_apply, TensorProduct.smul_tmul_smul, smul_smul]
      ring_nf
  rw [h, AddSubgroup.coe_map]
  exact Set.image_smul

end Span

/-! ## The relative index of a product of subgroups -/

section Pi

/-- **`[Π N : Π H] = [N : H] ^ n`** for subgroups `H`, `N` of an additive group and the products
over a finite index set with `n` elements (`AddSubgroup.index_pi` and a change of variables). -/
theorem tensorAdd_relIndex_pi {G : Type*} [AddGroup G] (ι : Type*) [Fintype ι]
    (H N : AddSubgroup G) :
    (AddSubgroup.pi Set.univ fun _ : ι => H).relIndex (AddSubgroup.pi Set.univ fun _ : ι => N) =
      H.relIndex N ^ Fintype.card ι := by
  let f : (ι → N) →+ (AddSubgroup.pi Set.univ fun _ : ι => N) :=
    { toFun := fun x => ⟨fun i => (x i : G), fun i _ => (x i).2⟩
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hf : Function.Surjective f := fun y =>
    ⟨fun i => ⟨(y : ι → G) i, y.2 i (Set.mem_univ i)⟩, rfl⟩
  have hc : ((AddSubgroup.pi Set.univ fun _ : ι => H).addSubgroupOf
      (AddSubgroup.pi Set.univ fun _ : ι => N)).comap f =
      AddSubgroup.pi Set.univ fun _ : ι => H.addSubgroupOf N := by
    ext x
    simp [f, AddSubgroup.mem_addSubgroupOf, AddSubgroup.mem_pi]
  rw [AddSubgroup.relIndex, ← AddSubgroup.index_comap_of_surjective _ hf, hc,
    AddSubgroup.index_pi, Finset.prod_const, Finset.card_univ, AddSubgroup.relIndex]

end Pi

/-! ## A full lattice is the `ℤ_p`-span of a `ℚ_p`-basis -/

section Basis

variable (p : ℕ) [hp : Fact p.Prime] (K : Type*) [Field K] [Algebra ℚ_[p] K] [Algebra ℤ_[p] K]
  [IsScalarTower ℤ_[p] ℚ_[p] K]

/-- **A full `ℤ_p`-lattice is the `ℤ_p`-span of a `ℚ_p`-basis**: a finitely generated
`ℤ_p`-submodule `M` of `K` whose `ℚ_p`-span is `K` is the set of the `∑ᵢ dᵢ cᵢ`, `dᵢ ∈ ℤ_p`, for
a `ℚ_p`-basis `c` of `K` contained in `M` (`ℤ_p` is a principal ideal domain with fraction field
`ℚ_p`; Mathlib's `Submodule.IsLattice.exists_basis_linearIndependent`). -/
theorem tensorAdd_exists_basis (M : Submodule ℤ_[p] K) (hfg : M.FG)
    (hs : Submodule.span ℚ_[p] (M : Set K) = ⊤) :
    ∃ (n : ℕ) (c : Module.Basis (Fin n) ℚ_[p] K), (∀ i, c i ∈ M) ∧
      ∀ y ∈ M, ∃ d : Fin n → ℤ_[p], y = ∑ i, (d i : ℚ_[p]) • c i := by
  have : Submodule.IsLattice ℚ_[p] M := Submodule.IsLattice.of_fg ℚ_[p] hfg
  obtain ⟨b, hb⟩ := Submodule.IsLattice.exists_basis_linearIndependent ℚ_[p] M
  have hrepr : ∀ y (hy : y ∈ M),
      y = ∑ i, ((b.repr ⟨y, hy⟩ i : ℤ_[p]) : ℚ_[p]) • (b i : K) := by
    intro y hy
    have h := congrArg (fun z : M => (z : K)) (b.sum_repr ⟨y, hy⟩)
    simp only [Submodule.coe_sum, Submodule.coe_smul] at h
    refine h.symm.trans (Finset.sum_congr rfl fun i _ => ?_)
    rw [← PadicInt.algebraMap_apply, algebraMap_smul]
  have hsp : ⊤ ≤ Submodule.span ℚ_[p] (Set.range fun i => (b i : K)) := by
    rw [← hs, Submodule.span_le]
    intro y hy
    rw [hrepr y hy]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  refine ⟨_, Module.Basis.mk hb hsp, fun i => ?_, fun y hy => ⟨fun i => b.repr ⟨y, hy⟩ i, ?_⟩⟩
  · rw [Module.Basis.mk_apply]
    exact (b i).2
  · simp only [Module.Basis.mk_apply]
    exact hrepr y hy

end Basis

/-! ## Item 1: the index of a tensor product of lattices -/

section Index

variable (p : ℕ) [hp : Fact p.Prime] (K₁ K₂ : Type*) [Field K₁] [Field K₂] [Algebra ℚ_[p] K₁]
  [Algebra ℚ_[p] K₂] [Algebra ℤ_[p] K₁] [Algebra ℤ_[p] K₂] [IsScalarTower ℤ_[p] ℚ_[p] K₁]
  [IsScalarTower ℤ_[p] ℚ_[p] K₂]

/-- The map `x ↦ ∑ᵢ xᵢ ⊗ cᵢ` from `K₁ ^ ι` to `K₁ ⊗ K₂` for a family `c` of `K₂`. -/
noncomputable def tensorAddCoordRight {ι : Type*} [Fintype ι] (c : ι → K₂) :
    (ι → K₁) →+ TensorProduct ℚ_[p] K₁ K₂ where
  toFun x := ∑ i, TensorProduct.tmul ℚ_[p] (x i) (c i)
  map_zero' := by simp
  map_add' x y := by simp [TensorProduct.add_tmul, Finset.sum_add_distrib]

omit [Algebra ℤ_[p] K₁] [Algebra ℤ_[p] K₂] [IsScalarTower ℤ_[p] ℚ_[p] K₁]
  [IsScalarTower ℤ_[p] ℚ_[p] K₂] in
/-- For a `ℚ_p`-basis `c` of `K₂`, `x ↦ ∑ᵢ xᵢ ⊗ cᵢ` is injective. -/
theorem tensorAddCoordRight_injective {ι : Type*} [Fintype ι] (c : Module.Basis ι ℚ_[p] K₂) :
    Function.Injective (tensorAddCoordRight p K₁ K₂ c) := by
  classical
  have key : ∀ (x : ι → K₁) (j : ι),
      TensorProduct.equivFinsuppOfBasisRight c (tensorAddCoordRight p K₁ K₂ c x) j = x j := by
    intro x j
    show TensorProduct.equivFinsuppOfBasisRight c (∑ i, TensorProduct.tmul ℚ_[p] (x i) (c i)) j = _
    rw [map_sum, Finsupp.finsetSum_apply]
    simp [Finsupp.single_apply]
  exact fun x y h => funext fun j => by rw [← key x j, ← key y j, h]

omit [Algebra ℤ_[p] K₂] [IsScalarTower ℤ_[p] ℚ_[p] K₂] in
/-- **Coordinates for a basis of the right factor**: for a family `c` of `K₂` whose `ℤ_p`-span is
`L` and a `ℤ_p`-submodule `N` of `K₁`, `x ↦ ∑ᵢ xᵢ ⊗ cᵢ` maps `N ^ ι` onto the image of
`N ⊗ L`. -/
theorem tensorAddCoordRight_map {ι : Type*} [Fintype ι] (c : ι → K₂)
    (L : Set K₂) (hc : ∀ i, c i ∈ L) (hL : ∀ y ∈ L, ∃ d : ι → ℤ_[p], y = ∑ i, (d i : ℚ_[p]) • c i)
    (N : Submodule ℤ_[p] K₁) :
    (AddSubgroup.pi Set.univ fun _ : ι => N.toAddSubgroup).map (tensorAddCoordRight p K₁ K₂ c) =
      tensorAddSpan p K₁ K₂ N L := by
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    exact AddSubgroup.sum_mem _ fun i _ => AddSubgroup.subset_closure ⟨1, x i, c i,
      hx i (Set.mem_univ i), hc i, by simp⟩
  · refine (AddSubgroup.closure_le _).2 ?_
    rintro _ ⟨a, x, y, hx, hy, rfl⟩
    obtain ⟨d, rfl⟩ := hL y hy
    refine ⟨fun i => (((a * d i : ℤ_[p]) : ℚ_[p])) • x, fun i _ => ?_, ?_⟩
    · show (((a * d i : ℤ_[p]) : ℚ_[p])) • x ∈ N
      rw [← PadicInt.algebraMap_apply, algebraMap_smul]
      exact N.smul_mem _ hx
    · show ∑ i, TensorProduct.tmul ℚ_[p] ((((a * d i : ℤ_[p]) : ℚ_[p])) • x) (c i) = _
      rw [TensorProduct.tmul_sum, Finset.smul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [TensorProduct.tmul_smul, smul_smul, ← TensorProduct.smul_tmul', PadicInt.coe_mul]

omit [Algebra ℤ_[p] K₂] [IsScalarTower ℤ_[p] ℚ_[p] K₂] in
/-- **The index with a fixed right factor**: for a `ℚ_p`-basis `c` of `K₂` with `ℤ_p`-span `L`
and `ℤ_p`-submodules `N`, `N'` of `K₁`, `[N' ⊗ L : N ⊗ L] = [N' : N] ^ [K₂ : ℚ_p]` (relative
indices of additive subgroups, `0` when infinite). -/
theorem tensorAdd_relIndex_right {ι : Type*} [Fintype ι] (c : Module.Basis ι ℚ_[p] K₂)
    (L : Set K₂) (hc : ∀ i, c i ∈ L) (hL : ∀ y ∈ L, ∃ d : ι → ℤ_[p], y = ∑ i, (d i : ℚ_[p]) • c i)
    (N N' : Submodule ℤ_[p] K₁) :
    (tensorAddSpan p K₁ K₂ N L).relIndex (tensorAddSpan p K₁ K₂ N' L) =
      N.toAddSubgroup.relIndex N'.toAddSubgroup ^ Module.finrank ℚ_[p] K₂ := by
  rw [← tensorAddCoordRight_map p K₁ K₂ c L hc hL N,
    ← tensorAddCoordRight_map p K₁ K₂ c L hc hL N',
    AddSubgroup.relIndex_map_map_of_injective _ _ (tensorAddCoordRight_injective p K₁ K₂ c),
    tensorAdd_relIndex_pi, Module.finrank_eq_card_basis c]

omit [Algebra ℤ_[p] K₁] [IsScalarTower ℤ_[p] ℚ_[p] K₁] in
/-- **The index with a fixed left factor**: for a `ℚ_p`-basis `b` of `K₁` with `ℤ_p`-span `M`
and `ℤ_p`-submodules `N`, `N'` of `K₂`, `[M ⊗ N' : M ⊗ N] = [N' : N] ^ [K₁ : ℚ_p]`. -/
theorem tensorAdd_relIndex_left {ι : Type*} [Fintype ι] (b : Module.Basis ι ℚ_[p] K₁)
    (M : Set K₁) (hb : ∀ i, b i ∈ M) (hM : ∀ x ∈ M, ∃ d : ι → ℤ_[p], x = ∑ i, (d i : ℚ_[p]) • b i)
    (N N' : Submodule ℤ_[p] K₂) :
    (tensorAddSpan p K₁ K₂ M N).relIndex (tensorAddSpan p K₁ K₂ M N') =
      N.toAddSubgroup.relIndex N'.toAddSubgroup ^ Module.finrank ℚ_[p] K₁ := by
  rw [← tensorAddSpan_map_comm p K₁ K₂ M (N : Set K₂),
    ← tensorAddSpan_map_comm p K₁ K₂ M (N' : Set K₂),
    AddSubgroup.relIndex_map_map_of_injective
      (f := (TensorProduct.comm ℚ_[p] K₂ K₁).toLinearMap.toAddMonoidHom) _ _
      (TensorProduct.comm ℚ_[p] K₂ K₁).injective,
    tensorAdd_relIndex_right p K₂ K₁ b M hb hM N N']

/-- **The index of a tensor product of lattices** (the fact behind the identity of IUT IV page 14,
`μ^log(log_p(R_I^×)) = ∑_i μ^log(log_p(R_i^×)) + μ^log(R_I)`, which the page uses without
proof): for `ℤ_p`-submodules `L₁ ≤ M₁` of `K₁` and `L₂ ≤ M₂` of `K₂`, where `M₁` and `L₂` are
full lattices (finitely generated, spanning over `ℚ_p`), the image of `L₁ ⊗_{ℤ_p} L₂` in
`K₁ ⊗[ℚ_p] K₂` has relative index `[M₁ : L₁] ^ d₂ · [M₂ : L₂] ^ d₁` in the image of
`M₁ ⊗_{ℤ_p} M₂`, `dᵢ = [Kᵢ : ℚ_p]`. Relative indices are those of additive subgroups (`0` when
infinite); no finiteness is assumed. The proof goes through `L₁ ⊗ L₂ ≤ M₁ ⊗ L₂ ≤ M₁ ⊗ M₂`, with
coordinates in a `ℚ_p`-basis of `K₂` spanning `L₂` over `ℤ_p` for the first step and one of `K₁`
spanning `M₁` for the second. -/
theorem tensorAdd_relIndex (L₁ M₁ : Submodule ℤ_[p] K₁) (L₂ M₂ : Submodule ℤ_[p] K₂)
    (h₁ : L₁ ≤ M₁) (h₂ : L₂ ≤ M₂) (hM₁ : M₁.FG) (hM₁s : Submodule.span ℚ_[p] (M₁ : Set K₁) = ⊤)
    (hL₂ : L₂.FG) (hL₂s : Submodule.span ℚ_[p] (L₂ : Set K₂) = ⊤) :
    (tensorAddSpan p K₁ K₂ L₁ L₂).relIndex (tensorAddSpan p K₁ K₂ M₁ M₂) =
      L₁.toAddSubgroup.relIndex M₁.toAddSubgroup ^ Module.finrank ℚ_[p] K₂ *
        L₂.toAddSubgroup.relIndex M₂.toAddSubgroup ^ Module.finrank ℚ_[p] K₁ := by
  obtain ⟨n₁, b, hb, hbM⟩ := tensorAdd_exists_basis p K₁ M₁ hM₁ hM₁s
  obtain ⟨n₂, c, hc, hcL⟩ := tensorAdd_exists_basis p K₂ L₂ hL₂ hL₂s
  have hA : tensorAddSpan p K₁ K₂ L₁ L₂ ≤ tensorAddSpan p K₁ K₂ M₁ L₂ :=
    tensorAddSpan_mono p K₁ K₂ (SetLike.coe_subset_coe.2 h₁) subset_rfl
  have hB : tensorAddSpan p K₁ K₂ M₁ L₂ ≤ tensorAddSpan p K₁ K₂ M₁ M₂ :=
    tensorAddSpan_mono p K₁ K₂ subset_rfl (SetLike.coe_subset_coe.2 h₂)
  refine (AddSubgroup.relIndex_mul_relIndex _ _ _ hA hB).symm.trans ?_
  rw [tensorAdd_relIndex_right p K₁ K₂ c L₂ hc hcL L₁ M₁,
    tensorAdd_relIndex_left p K₁ K₂ b M₁ hb hbM L₂ M₂]

end Index

/-! ## `R_E` as a span, lattices between powers of `p` times `R` -/

section Sandwich

variable (p : ℕ) [hp : Fact p.Prime]

/-- `R_E`: the span of `R₁ ⊗ R₂` is `padicPacketIntegers`, the carrier of `tensorIdxRing`. -/
theorem tensorAddSpan_integers (K₁ K₂ : Type*) [Field K₁] [Field K₂] [Algebra ℚ_[p] K₁]
    [Algebra ℚ_[p] K₂] [Algebra ℤ_[p] K₁] [Algebra ℤ_[p] K₂] [IsScalarTower ℤ_[p] ℚ_[p] K₁]
    [IsScalarTower ℤ_[p] ℚ_[p] K₂] :
    (tensorAddSpan p K₁ K₂ (integralClosure ℤ_[p] K₁ : Set K₁)
        (integralClosure ℤ_[p] K₂ : Set K₂) : Set (TensorProduct ℚ_[p] K₁ K₂)) =
      padicPacketIntegers p K₁ K₂ := by
  apply Set.Subset.antisymm
  · rw [← tensorIdxRing_coe]
    intro z hz
    have hle : tensorAddSpan p K₁ K₂ (integralClosure ℤ_[p] K₁ : Set K₁)
        (integralClosure ℤ_[p] K₂ : Set K₂) ≤ (tensorIdxRing p K₁ K₂).toAddSubgroup := by
      refine (AddSubgroup.closure_le _).2 ?_
      rintro _ ⟨a, x, y, hx, hy, rfl⟩
      have hg : TensorProduct.tmul ℚ_[p] x y ∈ tensorIdxRing p K₁ K₂ := by
        rw [← SetLike.mem_coe, tensorIdxRing_coe]
        exact AddSubmonoid.subset_closure ⟨x, y, (tensorDiff_padicVolIntegral_iff p K₁ x).2 hx,
          (tensorDiff_padicVolIntegral_iff p K₂ y).2 hy, rfl⟩
      exact tensorIdx_smul_mem p K₁ K₂ a hg
    exact hle hz
  · intro z hz
    unfold padicPacketIntegers at hz
    rw [SetLike.mem_coe] at hz
    refine (AddSubmonoid.closure_le (S := (tensorAddSpan p K₁ K₂
      (integralClosure ℤ_[p] K₁ : Set K₁) (integralClosure ℤ_[p] K₂ : Set K₂)).toAddSubmonoid)).2
      ?_ hz
    rintro _ ⟨x, y, hx, hy, rfl⟩
    exact AddSubgroup.subset_closure ⟨1, x, y, (tensorDiff_padicVolIntegral_iff p K₁ x).1 hx,
      (tensorDiff_padicVolIntegral_iff p K₂ y).1 hy, by simp⟩

variable (K : Type*) [Field K] [Algebra ℚ_[p] K] [FiniteDimensional ℚ_[p] K] [Algebra ℤ_[p] K]
  [IsScalarTower ℤ_[p] ℚ_[p] K]

/-- `p ^ k · R` as a `ℤ_p`-submodule of `K`, for `R = integralClosure ℤ_[p] K` and `k ∈ ℤ`. -/
noncomputable def tensorAddScaled (k : ℤ) : Submodule ℤ_[p] K :=
  (integralClosure ℤ_[p] K).toSubmodule.map
    ((((p : ℚ_[p]) ^ k) • LinearMap.id : K →ₗ[ℚ_[p]] K).restrictScalars ℤ_[p])

omit [FiniteDimensional ℚ_[p] K] in
/-- The carrier of `tensorAddScaled p K k` is `p ^ k • R`. -/
theorem tensorAddScaled_coe (k : ℤ) :
    (tensorAddScaled p K k : Set K) = ((p : ℚ_[p]) ^ k) • (integralClosure ℤ_[p] K : Set K) := by
  rw [tensorAddScaled, Submodule.map_coe]
  exact Set.image_smul

/-- `R = integralClosure ℤ_[p] K` is a finitely generated `ℤ_p`-submodule of `K`. -/
theorem tensorAdd_integers_fg : (integralClosure ℤ_[p] K).toSubmodule.FG := by
  have := unitVol_moduleFinite p K
  exact Module.Finite.iff_fg.1 this

/-- A `ℤ_p`-submodule contained in `p ^ k · R` is finitely generated. -/
theorem tensorAdd_fg_of_subset (L : Submodule ℤ_[p] K) (k : ℤ)
    (hhi : (L : Set K) ⊆ ((p : ℚ_[p]) ^ k) • (integralClosure ℤ_[p] K : Set K)) : L.FG := by
  have hT : (tensorAddScaled p K k).FG := by
    unfold tensorAddScaled
    exact (tensorAdd_integers_fg p K).map _
  refine hT.of_le fun x hx => ?_
  rw [← SetLike.mem_coe, tensorAddScaled_coe]
  exact hhi hx

/-- A `ℤ_p`-submodule containing `p ^ k · R` spans `K` over `ℚ_p`. -/
theorem tensorAdd_span_eq_top (L : Submodule ℤ_[p] K) (k : ℤ)
    (hlo : ((p : ℚ_[p]) ^ k) • (integralClosure ℤ_[p] K : Set K) ⊆ L) :
    Submodule.span ℚ_[p] (L : Set K) = ⊤ := by
  rw [eq_top_iff]
  intro z _
  obtain ⟨n, hn⟩ := packet_field_exists_pow_smul p K z
  have hR : ((p : ℚ_[p]) ^ n) • z ∈ integralClosure ℤ_[p] K :=
    (tensorDiff_padicVolIntegral_iff p K _).1 hn
  have hL : ((p : ℚ_[p]) ^ k) • (((p : ℚ_[p]) ^ n) • z) ∈ L := hlo (Set.smul_mem_smul_set hR)
  have hp0 : (p : ℚ_[p]) ≠ 0 := by exact_mod_cast hp.out.ne_zero
  have hne : ((p : ℚ_[p]) ^ k) * (p : ℚ_[p]) ^ n ≠ 0 :=
    mul_ne_zero (zpow_ne_zero _ hp0) (pow_ne_zero _ hp0)
  have hz : z = (((p : ℚ_[p]) ^ k) * (p : ℚ_[p]) ^ n)⁻¹ •
      (((p : ℚ_[p]) ^ k) • (((p : ℚ_[p]) ^ n) • z)) := by
    rw [smul_smul, smul_smul, mul_assoc, inv_mul_cancel₀ hne, one_smul]
  rw [hz]
  exact Submodule.smul_mem _ _ (Submodule.subset_span hL)

end Sandwich

/-! ## Haar measure of a lattice from an index -/

section Measure

variable (p : ℕ) [hp : Fact p.Prime]

/-- **From an index to the log-volume**: if `μ N = n · μ H` with `n ≠ 0` and `H`, `Λ` of positive
finite measure, then `μ^log(N) = μ^log(H) + log n / dim V` (normalized at `Λ`). -/
theorem tensorAdd_muLog_of_measure_eq {V : Type*} [NormedAddCommGroup V] [NormedSpace ℚ_[p] V]
    [FiniteDimensional ℚ_[p] V] [MeasurableSpace V] [BorelSpace V] (μ : Measure V)
    {Λ H N : Set V} {n : ℕ} (hn : n ≠ 0) (hΛ0 : μ Λ ≠ 0) (hΛ : μ Λ ≠ ⊤) (hH0 : μ H ≠ 0)
    (hH : μ H ≠ ⊤) (hN : μ N = n * μ H) :
    padicMuLog p μ Λ N = padicMuLog p μ Λ H + Real.log n / Module.finrank ℚ_[p] V := by
  unfold padicMuLog
  have hHp := ENNReal.toReal_pos hH0 hH
  have hΛp := ENNReal.toReal_pos hΛ0 hΛ
  have hn' : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero hn
  rw [hN, ENNReal.toReal_mul, ENNReal.toReal_natCast, mul_div_assoc,
    Real.log_mul hn'.ne' (div_pos hHp hΛp).ne', add_div, add_comm]

variable (K : Type*) [Field K] [Algebra ℚ_[p] K] [FiniteDimensional ℚ_[p] K] [Algebra ℤ_[p] K]
  [IsScalarTower ℤ_[p] ℚ_[p] K]

/-- **One factor**: for a `ℤ_p`-submodule `L` of `K` with `p ^ k · R ⊆ L ⊆ p ^ (−k) · R`
(`R = integralClosure ℤ_[p] K`, `k ∈ ℕ`) and every additive Haar measure on `K` (spectral norm,
Borel sets): the index `[L : p ^ k · R]` is finite and nonzero, `L` has positive finite measure,
and `μ^log(L) = −k log p + log [L : p ^ k · R] / [K : ℚ_p]` for the log-volume normalized by
`μ^log(R) = 0` and divided by `[K : ℚ_p]`. -/
theorem tensorAdd_muLog_one (L : Submodule ℤ_[p] K) (k : ℕ)
    (hlo : ((p : ℚ_[p]) ^ (k : ℤ)) • (integralClosure ℤ_[p] K : Set K) ⊆ L)
    (hhi : (L : Set K) ⊆ ((p : ℚ_[p]) ^ (-(k : ℤ))) • (integralClosure ℤ_[p] K : Set K)) :
    letI := spectralNorm.normedField ℚ_[p] K
    letI := spectralNorm.normedAlgebra ℚ_[p] K
    letI : MeasurableSpace K := borel K
    ∀ (μ : Measure K) [μ.IsAddHaarMeasure],
      (tensorAddScaled p K k).toAddSubgroup.relIndex L.toAddSubgroup ≠ 0 ∧
      μ (L : Set K) ≠ 0 ∧ μ (L : Set K) ≠ ⊤ ∧
      padicMuLog p μ (integralClosure ℤ_[p] K : Set K) L =
        -(k * Real.log p) + Real.log ((tensorAddScaled p K k).toAddSubgroup.relIndex
          L.toAddSubgroup) / Module.finrank ℚ_[p] K := by
  let := spectralNorm.normedField ℚ_[p] K
  let := spectralNorm.normedAlgebra ℚ_[p] K
  let _ : MeasurableSpace K := borel K
  have : BorelSpace K := ⟨rfl⟩
  intro μ _
  have hp0 : (p : ℚ_[p]) ≠ 0 := by exact_mod_cast hp.out.ne_zero
  obtain ⟨hRo, hRc⟩ := padicVol_unitBall_isOpen_isCompact p (K := K)
  rw [← padicBridge_integralClosure_eq_unitBall p K] at hRo hRc
  obtain ⟨hR0, hR1, -, -⟩ := volBridge_muLog_integralClosure p K μ
  have hCo : IsOpen (tensorAddScaled p K k : Set K) := by
    rw [tensorAddScaled_coe]
    exact hRo.smul₀ (zpow_ne_zero _ hp0)
  have hCc : IsCompact (tensorAddScaled p K k : Set K) := by
    rw [tensorAddScaled_coe]
    exact hRc.smul _
  have hC0 : (0 : K) ∈ (tensorAddScaled p K k : Set K) := zero_mem _
  have hCL : (tensorAddScaled p K k).toAddSubgroup ≤ L.toAddSubgroup := by
    intro x hx
    have hx' : x ∈ (tensorAddScaled p K k : Set K) := hx
    rw [tensorAddScaled_coe] at hx'
    exact hlo hx'
  have hLo : IsOpen (L.toAddSubgroup : Set K) :=
    L.toAddSubgroup.isOpen_of_mem_nhds (Filter.mem_of_superset (hCo.mem_nhds hC0) hCL)
  have hLc : IsCompact (L.toAddSubgroup : Set K) :=
    (hRc.smul ((p : ℚ_[p]) ^ (-(k : ℤ)))).of_isClosed_subset
      (L.toAddSubgroup.isClosed_of_isOpen hLo) hhi
  have hfin := tensorIdx_finite_quotient hCL hCo hLc
  have hn : (tensorAddScaled p K k).toAddSubgroup.relIndex L.toAddSubgroup ≠ 0 :=
    Nat.card_pos.ne'
  have hmeas := tensorIdx_measure_eq_relIndex μ hCL hCo.measurableSet
  have hC0' : μ (tensorAddScaled p K k : Set K) ≠ 0 := hCo.measure_ne_zero μ ⟨0, hC0⟩
  have hC1 : μ (tensorAddScaled p K k : Set K) ≠ ⊤ := hCc.measure_lt_top.ne
  have hd : 0 < Module.finrank ℚ_[p] K := Module.finrank_pos
  have hstep := tensorAdd_muLog_of_measure_eq p μ hn hR0 hR1 hC0' hC1 hmeas
  have hCmu : padicMuLog p μ (integralClosure ℤ_[p] K : Set K) (tensorAddScaled p K k : Set K) =
      -(k * Real.log p) := by
    rw [tensorAddScaled_coe, padicMuLog_p_zpow_smul p μ hd hR0 hR1 hR0 hR1, padicMuLog_self]
    push_cast
    ring
  refine ⟨hn, ?_, ?_, ?_⟩
  · show μ (L.toAddSubgroup : Set K) ≠ 0
    rw [hmeas]
    exact mul_ne_zero (by exact_mod_cast hn) hC0'
  · show μ (L.toAddSubgroup : Set K) ≠ ⊤
    rw [hmeas]
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _) hC1
  · show padicMuLog p μ _ (L.toAddSubgroup : Set K) = _
    rw [hstep]
    show padicMuLog p μ _ (tensorAddScaled p K k : Set K) + _ = _
    rw [hCmu]

/-- The index `[L : p ^ k · R]` of `tensorAdd_muLog_one` is finite and nonzero. -/
theorem tensorAdd_one_relIndex_ne_zero (L : Submodule ℤ_[p] K) (k : ℕ)
    (hlo : ((p : ℚ_[p]) ^ (k : ℤ)) • (integralClosure ℤ_[p] K : Set K) ⊆ L)
    (hhi : (L : Set K) ⊆ ((p : ℚ_[p]) ^ (-(k : ℤ))) • (integralClosure ℤ_[p] K : Set K)) :
    (tensorAddScaled p K k).toAddSubgroup.relIndex L.toAddSubgroup ≠ 0 := by
  let := spectralNorm.normedField ℚ_[p] K
  let := spectralNorm.normedAlgebra ℚ_[p] K
  let _ : MeasurableSpace K := borel K
  have : BorelSpace K := ⟨rfl⟩
  have : ProperSpace K := FiniteDimensional.proper ℚ_[p] K
  exact (tensorAdd_muLog_one p K L k hlo hhi Measure.addHaar).1

/-- **The log-volume `μ^log` of one factor** (IUT IV Proposition 1.4 (i), page 13, for one
finite extension `K` of `ℚ_p`): `padicMuLog` for the spectral norm, the Borel sets and the
additive Haar measure `Measure.addHaar`, normalized by `μ^log(R) = 0`
(`R = integralClosure ℤ_[p] K`) and divided by `[K : ℚ_p]`. By `padicMuLog_haar_indep` every
other additive Haar measure gives the same values. -/
noncomputable def tensorAddMuLog (A : Set K) : ℝ :=
  letI := spectralNorm.normedField ℚ_[p] K
  letI := spectralNorm.normedAlgebra ℚ_[p] K
  letI : MeasurableSpace K := borel K
  haveI : BorelSpace K := ⟨rfl⟩
  haveI : ProperSpace K := FiniteDimensional.proper ℚ_[p] K
  padicMuLog p (Measure.addHaar : Measure K) (integralClosure ℤ_[p] K : Set K) A

/-- The value of `tensorAddMuLog` on a lattice between `p ^ k · R` and `p ^ (−k) · R`. -/
theorem tensorAddMuLog_eq (L : Submodule ℤ_[p] K) (k : ℕ)
    (hlo : ((p : ℚ_[p]) ^ (k : ℤ)) • (integralClosure ℤ_[p] K : Set K) ⊆ L)
    (hhi : (L : Set K) ⊆ ((p : ℚ_[p]) ^ (-(k : ℤ))) • (integralClosure ℤ_[p] K : Set K)) :
    tensorAddMuLog p K L = -(k * Real.log p) +
      Real.log ((tensorAddScaled p K k).toAddSubgroup.relIndex L.toAddSubgroup) /
        Module.finrank ℚ_[p] K := by
  let := spectralNorm.normedField ℚ_[p] K
  let := spectralNorm.normedAlgebra ℚ_[p] K
  let _ : MeasurableSpace K := borel K
  have : BorelSpace K := ⟨rfl⟩
  have : ProperSpace K := FiniteDimensional.proper ℚ_[p] K
  exact (tensorAdd_muLog_one p K L k hlo hhi Measure.addHaar).2.2.2

end Measure

/-! ## Item 2: identity (A) for two factors -/

section Additivity

variable (p : ℕ) [hp : Fact p.Prime] (K₁ K₂ : Type*) [Field K₁] [Field K₂] [Algebra ℚ_[p] K₁]
  [Algebra ℚ_[p] K₂] [FiniteDimensional ℚ_[p] K₁] [FiniteDimensional ℚ_[p] K₂]
  [Algebra ℤ_[p] K₁] [Algebra ℤ_[p] K₂] [IsScalarTower ℤ_[p] ℚ_[p] K₁]
  [IsScalarTower ℤ_[p] ℚ_[p] K₂]
  [MeasurableSpace (Fin (Module.finrank ℚ_[p] (TensorProduct ℚ_[p] K₁ K₂)) → ℚ_[p])]
  [BorelSpace (Fin (Module.finrank ℚ_[p] (TensorProduct ℚ_[p] K₁ K₂)) → ℚ_[p])]
  (μ : Measure (Fin (Module.finrank ℚ_[p] (TensorProduct ℚ_[p] K₁ K₂)) → ℚ_[p]))
  [μ.IsAddHaarMeasure]

/-- **The tensor side of (A)**: for `ℤ_p`-submodules `L₁ ⊆ K₁`, `L₂ ⊆ K₂` with
`p ^ kᵢ · Rᵢ ⊆ Lᵢ ⊆ p ^ (−kᵢ) · Rᵢ`, the packet log-volume (normalized by `μ^log((R_E)^∼) = 0`) of
the image of `L₁ ⊗_{ℤ_p} L₂` is `μ^log(R_E) − (k₁ + k₂) log p + ∑ᵢ log [Lᵢ : p ^ kᵢ Rᵢ] / dᵢ`.
The proof: `p ^ (k₁ + k₂) · R_E` is the image of `p ^ k₁ R₁ ⊗ p ^ k₂ R₂`, its index in the image
of `L₁ ⊗ L₂` is `[L₁ : p ^ k₁ R₁] ^ d₂ · [L₂ : p ^ k₂ R₂] ^ d₁` (`tensorAdd_relIndex`), and Haar
measure multiplies by the index. -/
theorem tensorAdd_muLog_tensor (L₁ : Submodule ℤ_[p] K₁) (L₂ : Submodule ℤ_[p] K₂) (k₁ k₂ : ℕ)
    (hlo₁ : ((p : ℚ_[p]) ^ (k₁ : ℤ)) • (integralClosure ℤ_[p] K₁ : Set K₁) ⊆ L₁)
    (hhi₁ : (L₁ : Set K₁) ⊆ ((p : ℚ_[p]) ^ (-(k₁ : ℤ))) • (integralClosure ℤ_[p] K₁ : Set K₁))
    (hlo₂ : ((p : ℚ_[p]) ^ (k₂ : ℤ)) • (integralClosure ℤ_[p] K₂ : Set K₂) ⊆ L₂)
    (hhi₂ : (L₂ : Set K₂) ⊆ ((p : ℚ_[p]) ^ (-(k₂ : ℤ))) • (integralClosure ℤ_[p] K₂ : Set K₂)) :
    padicPacketMuLog p (TensorProduct ℚ_[p] K₁ K₂) μ (padicPacketNormalization p K₁ K₂)
        (tensorAddSpan p K₁ K₂ L₁ L₂) =
      padicPacketMuLog p (TensorProduct ℚ_[p] K₁ K₂) μ (padicPacketNormalization p K₁ K₂)
          (padicPacketIntegers p K₁ K₂) - ((k₁ : ℝ) + k₂) * Real.log p +
        Real.log ((tensorAddScaled p K₁ k₁).toAddSubgroup.relIndex L₁.toAddSubgroup) /
          Module.finrank ℚ_[p] K₁ +
        Real.log ((tensorAddScaled p K₂ k₂).toAddSubgroup.relIndex L₂.toAddSubgroup) /
          Module.finrank ℚ_[p] K₂ := by
  have hp0 : (p : ℚ_[p]) ≠ 0 := by exact_mod_cast hp.out.ne_zero
  set c := (Module.finBasis ℚ_[p] (TensorProduct ℚ_[p] K₁ K₂)).equivFun
  have hC₁ : tensorAddScaled p K₁ k₁ ≤ L₁ := fun x hx => by
    have hx' : x ∈ (tensorAddScaled p K₁ k₁ : Set K₁) := hx
    rw [tensorAddScaled_coe] at hx'
    exact hlo₁ hx'
  have hC₂ : tensorAddScaled p K₂ k₂ ≤ L₂ := fun x hx => by
    have hx' : x ∈ (tensorAddScaled p K₂ k₂ : Set K₂) := hx
    rw [tensorAddScaled_coe] at hx'
    exact hlo₂ hx'
  have hidx := tensorAdd_relIndex p K₁ K₂ (tensorAddScaled p K₁ k₁) L₁ (tensorAddScaled p K₂ k₂)
    L₂ hC₁ hC₂ (tensorAdd_fg_of_subset p K₁ L₁ _ hhi₁) (tensorAdd_span_eq_top p K₁ L₁ _ hlo₁)
    (tensorAdd_fg_of_subset p K₂ _ (k₂ : ℤ) (tensorAddScaled_coe p K₂ _).le)
    (tensorAdd_span_eq_top p K₂ _ (k₂ : ℤ) (tensorAddScaled_coe p K₂ _).ge)
  have ha₁ := tensorAdd_one_relIndex_ne_zero p K₁ L₁ k₁ hlo₁ hhi₁
  have ha₂ := tensorAdd_one_relIndex_ne_zero p K₂ L₂ k₂ hlo₂ hhi₂
  have hHN : tensorAddSpan p K₁ K₂ (tensorAddScaled p K₁ k₁) (tensorAddScaled p K₂ k₂) ≤
      tensorAddSpan p K₁ K₂ L₁ L₂ :=
    tensorAddSpan_mono p K₁ K₂ (SetLike.coe_subset_coe.2 hC₁) (SetLike.coe_subset_coe.2 hC₂)
  have hHcoe : (tensorAddSpan p K₁ K₂ (tensorAddScaled p K₁ k₁) (tensorAddScaled p K₂ k₂) :
      Set (TensorProduct ℚ_[p] K₁ K₂)) =
      ((p : ℚ_[p]) ^ (((k₁ + k₂ : ℕ)) : ℤ)) • padicPacketIntegers p K₁ K₂ := by
    rw [tensorAddScaled_coe, tensorAddScaled_coe, tensorAddSpan_smul, tensorAddSpan_integers,
      ← zpow_add₀ hp0]
    push_cast
    rfl
  obtain ⟨hRo, hRc, -, -⟩ := tensorIdx_coord_isOpen_isCompact p K₁ K₂
  have hc : ((tensorIdxRing p K₁ K₂).toAddSubgroup : Set (TensorProduct ℚ_[p] K₁ K₂)) =
      padicPacketIntegers p K₁ K₂ := tensorIdxRing_coe p K₁ K₂
  rw [tensorIdxCoordMap_coe, hc] at hRo hRc
  have hHo : IsOpen (tensorIdxCoordMap p K₁ K₂
      (tensorAddSpan p K₁ K₂ (tensorAddScaled p K₁ k₁) (tensorAddScaled p K₂ k₂)) :
        Set (Fin (Module.finrank ℚ_[p] (TensorProduct ℚ_[p] K₁ K₂)) → ℚ_[p])) := by
    rw [tensorIdxCoordMap_coe, hHcoe, padicVol_image_smul p]
    exact hRo.smul₀ (zpow_ne_zero _ hp0)
  have hne : (tensorIdxCoordMap p K₁ K₂
      (tensorAddSpan p K₁ K₂ (tensorAddScaled p K₁ k₁) (tensorAddScaled p K₂ k₂))).relIndex
      (tensorIdxCoordMap p K₁ K₂ (tensorAddSpan p K₁ K₂ L₁ L₂)) ≠ 0 := by
    rw [tensorIdxCoordMap_relIndex, hidx]
    exact mul_ne_zero (pow_ne_zero _ ha₁) (pow_ne_zero _ ha₂)
  have hle : tensorIdxCoordMap p K₁ K₂
      (tensorAddSpan p K₁ K₂ (tensorAddScaled p K₁ k₁) (tensorAddScaled p K₂ k₂)) ≤
      tensorIdxCoordMap p K₁ K₂ (tensorAddSpan p K₁ K₂ L₁ L₂) := AddSubgroup.map_mono hHN
  have : Finite (↥(tensorIdxCoordMap p K₁ K₂ (tensorAddSpan p K₁ K₂ L₁ L₂)) ⧸
      (tensorIdxCoordMap p K₁ K₂ (tensorAddSpan p K₁ K₂ (tensorAddScaled p K₁ k₁)
        (tensorAddScaled p K₂ k₂))).addSubgroupOf
      (tensorIdxCoordMap p K₁ K₂ (tensorAddSpan p K₁ K₂ L₁ L₂))) :=
    Nat.finite_of_card_ne_zero hne
  have hmeas := tensorIdx_measure_eq_relIndex μ hle hHo.measurableSet
  rw [tensorIdxCoordMap_relIndex, tensorIdxCoordMap_coe, tensorIdxCoordMap_coe, hHcoe] at hmeas
  obtain ⟨hR0, hR1, -⟩ := tensorIdx_measure p K₁ K₂ μ
  obtain ⟨hS0, hS1⟩ := tensorLog_measure_zpow_smul p K₁ K₂ μ hR0 hR1 ((k₁ + k₂ : ℕ) : ℤ)
  have hN := tensorLog_normalization_measure p K₁ K₂ μ
  have hn : (tensorAddSpan p K₁ K₂ (tensorAddScaled p K₁ k₁) (tensorAddScaled p K₂ k₂)).relIndex
      (tensorAddSpan p K₁ K₂ L₁ L₂) ≠ 0 := by
    rw [hidx]
    exact mul_ne_zero (pow_ne_zero _ ha₁) (pow_ne_zero _ ha₂)
  have h3 : padicPacketMuLog p (TensorProduct ℚ_[p] K₁ K₂) μ (padicPacketNormalization p K₁ K₂)
      (tensorAddSpan p K₁ K₂ L₁ L₂) =
      padicPacketMuLog p (TensorProduct ℚ_[p] K₁ K₂) μ (padicPacketNormalization p K₁ K₂)
        (((p : ℚ_[p]) ^ (((k₁ + k₂ : ℕ)) : ℤ)) • padicPacketIntegers p K₁ K₂) +
      Real.log ((tensorAddSpan p K₁ K₂ (tensorAddScaled p K₁ k₁)
        (tensorAddScaled p K₂ k₂)).relIndex (tensorAddSpan p K₁ K₂ L₁ L₂)) /
        Module.finrank ℚ_[p] (TensorProduct ℚ_[p] K₁ K₂) := by
    have h := tensorAdd_muLog_of_measure_eq p μ hn hN.1 hN.2.1 hS0 hS1 hmeas
    rw [Module.finrank_fin_fun] at h
    exact h
  rw [h3, padicPacketMuLog_p_zpow_smul p μ (tensorLog_finrank_pos p K₁ K₂) hN.1 hN.2.1 hR0 hR1,
    hidx, Module.finrank_tensorProduct]
  have hd₁ : (0 : ℝ) < Module.finrank ℚ_[p] K₁ := by exact_mod_cast Module.finrank_pos
  have hd₂ : (0 : ℝ) < Module.finrank ℚ_[p] K₂ := by exact_mod_cast Module.finrank_pos
  have hb₁ : (0 : ℝ) < ((tensorAddScaled p K₁ k₁).toAddSubgroup.relIndex L₁.toAddSubgroup : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero ha₁
  have hb₂ : (0 : ℝ) < ((tensorAddScaled p K₂ k₂).toAddSubgroup.relIndex L₂.toAddSubgroup : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero ha₂
  push_cast
  rw [Real.log_mul (pow_pos hb₁ _).ne' (pow_pos hb₂ _).ne', Real.log_pow, Real.log_pow]
  field_simp
  ring

/-- **Identity (A) for two factors, for lattices** (IUT IV page 14, in general form): for
`ℤ_p`-submodules `L₁ ⊆ K₁`, `L₂ ⊆ K₂` with `p ^ kᵢ · Rᵢ ⊆ Lᵢ ⊆ p ^ (−kᵢ) · Rᵢ` for some
`kᵢ ∈ ℕ` (that is, full `ℤ_p`-lattices), the packet log-volume of the image of `L₁ ⊗_{ℤ_p} L₂`
in `K₁ ⊗[ℚ_p] K₂` (normalized by `μ^log((R_E)^∼) = 0`, for any Haar measure `μ` in coordinates)
is `μ^log(L₁) + μ^log(L₂) + μ^log(R_E)`, with `μ^log(Lᵢ)` the log-volume of `Kᵢ` normalized by
`μ^log(Rᵢ) = 0` (`tensorAddMuLog`). -/
theorem tensorAdd_muLog_add (L₁ : Submodule ℤ_[p] K₁) (L₂ : Submodule ℤ_[p] K₂) (k₁ k₂ : ℕ)
    (hlo₁ : ((p : ℚ_[p]) ^ (k₁ : ℤ)) • (integralClosure ℤ_[p] K₁ : Set K₁) ⊆ L₁)
    (hhi₁ : (L₁ : Set K₁) ⊆ ((p : ℚ_[p]) ^ (-(k₁ : ℤ))) • (integralClosure ℤ_[p] K₁ : Set K₁))
    (hlo₂ : ((p : ℚ_[p]) ^ (k₂ : ℤ)) • (integralClosure ℤ_[p] K₂ : Set K₂) ⊆ L₂)
    (hhi₂ : (L₂ : Set K₂) ⊆ ((p : ℚ_[p]) ^ (-(k₂ : ℤ))) • (integralClosure ℤ_[p] K₂ : Set K₂)) :
    padicPacketMuLog p (TensorProduct ℚ_[p] K₁ K₂) μ (padicPacketNormalization p K₁ K₂)
        (tensorAddSpan p K₁ K₂ L₁ L₂) =
      tensorAddMuLog p K₁ L₁ + tensorAddMuLog p K₂ L₂ +
        padicPacketMuLog p (TensorProduct ℚ_[p] K₁ K₂) μ (padicPacketNormalization p K₁ K₂)
          (padicPacketIntegers p K₁ K₂) := by
  rw [tensorAdd_muLog_tensor p K₁ K₂ μ L₁ L₂ k₁ k₂ hlo₁ hhi₁ hlo₂ hhi₂,
    tensorAddMuLog_eq p K₁ L₁ k₁ hlo₁ hhi₁, tensorAddMuLog_eq p K₂ L₂ k₂ hlo₂ hhi₂]
  ring

end Additivity

/-! ## `log_p(R^×)` as a `ℤ_p`-lattice -/

section LogLattice

variable (p : ℕ) [hp : Fact p.Prime] (K : Type*) [Field K] [Algebra ℚ_[p] K]
  [FiniteDimensional ℚ_[p] K] [Algebra ℤ_[p] K] [IsScalarTower ℤ_[p] ℚ_[p] K]

/-- `log_p(R^×)` is closed under addition: `log_p(u) + log_p(v) = log_p(u v)`. -/
theorem tensorAdd_logUnits_add {x y : K} (hx : x ∈ tensorLogUnits p K)
    (hy : y ∈ tensorLogUnits p K) : x + y ∈ tensorLogUnits p K := by
  let := spectralNorm.normedField ℚ_[p] K
  let := spectralNorm.normedAlgebra ℚ_[p] K
  obtain ⟨_, ⟨u, rfl⟩, rfl⟩ := hx
  obtain ⟨_, ⟨v, rfl⟩, rfl⟩ := hy
  have hu := (padicBridge_isUnit_iff p K (u : integralClosure ℤ_[p] K)).1 u.isUnit
  have hv := (padicBridge_isUnit_iff p K (v : integralClosure ℤ_[p] K)).1 v.isUnit
  refine ⟨_, ⟨u * v, rfl⟩, ?_⟩
  show extLogUnit (((u : integralClosure ℤ_[p] K) : K) * ((v : integralClosure ℤ_[p] K) : K)) = _
  exact unitVol_extLogUnit_mul p hu hv

omit [IsScalarTower ℤ_[p] ℚ_[p] K] in
/-- `0 = log_p(1) ∈ log_p(R^×)`. -/
theorem tensorAdd_logUnits_zero : (0 : K) ∈ tensorLogUnits p K := by
  let := spectralNorm.normedField ℚ_[p] K
  let := spectralNorm.normedAlgebra ℚ_[p] K
  refine ⟨_, ⟨1, rfl⟩, ?_⟩
  show extLogUnit (1 : K) = 0
  exact unitVol_extLogUnit_one p

/-- `log_p(R^×)` is stable under `ℤ_p`: for `c ∈ ℤ_p`, write `c = n + (c − n)` with `n ∈ ℕ` and
`c − n` divisible by a high power of `p`; then `n · x ∈ log_p(R^×)` by additivity, and
`(c − n) · x` lies in the ball `{‖z‖ ≤ p ^ (−a)}` contained in `log_p(R^×)`
(`padicBridge_extLogUnit_image_bounds`). -/
theorem tensorAdd_logUnits_smul (c : ℤ_[p]) {x : K} (hx : x ∈ tensorLogUnits p K) :
    (c : ℚ_[p]) • x ∈ tensorLogUnits p K := by
  let := spectralNorm.normedField ℚ_[p] K
  let := spectralNorm.normedAlgebra ℚ_[p] K
  have := padicBridge_isLocalRing p K
  have := padicBridge_maximalIdeal_liesOver p K
  obtain ⟨hlo, hhi⟩ := padicBridge_extLogUnit_image_bounds p K
    (IsLocalRing.maximalIdeal (integralClosure ℤ_[p] K))
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.out.pos
  have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast hp.out.one_lt.le
  obtain ⟨m, hm⟩ := exists_nat_ge
    (Proposition1_2.a p ((IsLocalRing.maximalIdeal (integralClosure ℤ_[p] K)).ramificationIdx
      ℤ_[p]) +
    Proposition1_2.b p ((IsLocalRing.maximalIdeal (integralClosure ℤ_[p] K)).ramificationIdx
      ℤ_[p]))
  let S : AddSubmonoid K :=
    { carrier := tensorLogUnits p K
      add_mem' := tensorAdd_logUnits_add p K
      zero_mem' := tensorAdd_logUnits_zero p K }
  have hd : ‖((c - (PadicInt.appr c m : ℤ_[p]) : ℤ_[p]) : ℚ_[p])‖ ≤ (p : ℝ) ^ (-(m : ℝ)) := by
    have h := (PadicInt.norm_le_pow_iff_mem_span_pow _ m).2 (PadicInt.appr_spec m c)
    rw [PadicInt.norm_def, ← Real.rpow_intCast] at h
    push_cast at h
    exact h
  have hsplit : (c : ℚ_[p]) • x = (PadicInt.appr c m) • x +
      ((c - (PadicInt.appr c m : ℤ_[p]) : ℤ_[p]) : ℚ_[p]) • x := by
    rw [PadicInt.coe_sub, PadicInt.coe_natCast, sub_smul, Nat.cast_smul_eq_nsmul]
    abel
  rw [hsplit]
  refine S.add_mem (S.nsmul_mem hx _) (hlo ?_)
  show ‖_‖ ≤ _
  rw [norm_smul]
  have hxb : ‖x‖ ≤ _ := hhi hx
  calc _ ≤ (p : ℝ) ^ (-(m : ℝ)) * (p : ℝ) ^ (Proposition1_2.b p
        ((IsLocalRing.maximalIdeal (integralClosure ℤ_[p] K)).ramificationIdx ℤ_[p])) :=
        mul_le_mul hd hxb (norm_nonneg _) (by positivity)
    _ = (p : ℝ) ^ (-(m : ℝ) + Proposition1_2.b p
        ((IsLocalRing.maximalIdeal (integralClosure ℤ_[p] K)).ramificationIdx ℤ_[p])) :=
        (Real.rpow_add hp0 _ _).symm
    _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hp1 (by linarith)

/-- **`log_p(R^×)` as a `ℤ_p`-submodule of `K`** (its carrier is `tensorLogUnits p K`). -/
noncomputable def tensorAddLogSubmodule : Submodule ℤ_[p] K where
  carrier := tensorLogUnits p K
  add_mem' := tensorAdd_logUnits_add p K
  zero_mem' := tensorAdd_logUnits_zero p K
  smul_mem' c x hx := by
    show c • x ∈ tensorLogUnits p K
    rw [← algebraMap_smul ℚ_[p] c x, PadicInt.algebraMap_apply]
    exact tensorAdd_logUnits_smul p K c hx

/-- **`log_p(R^×)` lies between two powers of `p` times `R`**: `p ^ k · R ⊆ log_p(R^×) ⊆
p ^ (−k) · R` for some `k ∈ ℕ` (from the balls of `padicBridge_extLogUnit_image_bounds`). -/
theorem tensorAdd_logUnits_sandwich : ∃ k : ℕ,
    ((p : ℚ_[p]) ^ (k : ℤ)) • (integralClosure ℤ_[p] K : Set K) ⊆ tensorLogUnits p K ∧
      tensorLogUnits p K ⊆ ((p : ℚ_[p]) ^ (-(k : ℤ))) • (integralClosure ℤ_[p] K : Set K) := by
  let := spectralNorm.normedField ℚ_[p] K
  let := spectralNorm.normedAlgebra ℚ_[p] K
  have := padicBridge_isLocalRing p K
  have := padicBridge_maximalIdeal_liesOver p K
  obtain ⟨hlo, hhi⟩ := padicBridge_extLogUnit_image_bounds p K
    (IsLocalRing.maximalIdeal (integralClosure ℤ_[p] K))
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.out.pos
  have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast hp.out.one_lt.le
  have hpq : (p : ℚ_[p]) ≠ 0 := by exact_mod_cast hp.out.ne_zero
  obtain ⟨k, hk⟩ := exists_nat_ge
    (max (Proposition1_2.a p ((IsLocalRing.maximalIdeal (integralClosure ℤ_[p] K)).ramificationIdx
      ℤ_[p]))
    (Proposition1_2.b p ((IsLocalRing.maximalIdeal (integralClosure ℤ_[p] K)).ramificationIdx
      ℤ_[p])))
  have hka := (le_max_left _ _).trans hk
  have hkb := (le_max_right _ _).trans hk
  refine ⟨k, ?_, fun x hx => ?_⟩
  · rintro _ ⟨r, hr, rfl⟩
    apply hlo
    show ‖_‖ ≤ _
    have hr1 : ‖r‖ ≤ 1 := (padicBridge_mem_integralClosure_iff p K r).1 hr
    rw [tensorLog_norm_p_zpow_smul]
    calc _ ≤ (p : ℝ) ^ (-(((k : ℤ)) : ℝ)) * 1 :=
          mul_le_mul_of_nonneg_left hr1 (by positivity)
      _ ≤ _ := by
          rw [mul_one]
          exact Real.rpow_le_rpow_of_exponent_le hp1 (by push_cast; linarith)
  · have hxb : ‖x‖ ≤ _ := hhi hx
    refine ⟨((p : ℚ_[p]) ^ (k : ℤ)) • x, ?_, ?_⟩
    · show _ ∈ integralClosure ℤ_[p] K
      rw [padicBridge_mem_integralClosure_iff p K, tensorLog_norm_p_zpow_smul]
      calc _ ≤ (p : ℝ) ^ (-(((k : ℤ)) : ℝ)) * (p : ℝ) ^ (Proposition1_2.b p
            ((IsLocalRing.maximalIdeal (integralClosure ℤ_[p] K)).ramificationIdx ℤ_[p])) :=
            mul_le_mul_of_nonneg_left hxb (by positivity)
        _ = (p : ℝ) ^ (-(((k : ℤ)) : ℝ) + Proposition1_2.b p
            ((IsLocalRing.maximalIdeal (integralClosure ℤ_[p] K)).ramificationIdx ℤ_[p])) :=
            (Real.rpow_add hp0 _ _).symm
        _ ≤ (p : ℝ) ^ (0 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le hp1 (by push_cast; linarith)
        _ = 1 := Real.rpow_zero _
    · show ((p : ℚ_[p]) ^ (-(k : ℤ))) • (((p : ℚ_[p]) ^ (k : ℤ)) • x) = x
      rw [smul_smul, ← zpow_add₀ hpq, neg_add_cancel, zpow_zero, one_smul]

/-- **Proposition 1.4 (ii) as a value of `tensorAddMuLog`** (page 13):
`μ^log(log_p(R^×)) = −(1 / e + m / (e f)) log p` (`unitVol_muLog_logUnit_eq`). -/
theorem tensorAddMuLog_logUnits (P : Ideal (integralClosure ℤ_[p] K)) [P.IsPrime]
    [P.LiesOver (IsLocalRing.maximalIdeal ℤ_[p])] :
    tensorAddMuLog p K (tensorLogUnits p K) =
      -(1 / (P.ramificationIdx ℤ_[p] : ℝ) +
          (unitVolTorsionExponent p K : ℝ) /
            ((P.ramificationIdx ℤ_[p] : ℝ) * unitVolResidueDegree p K)) * Real.log p := by
  let := spectralNorm.normedField ℚ_[p] K
  let := spectralNorm.normedAlgebra ℚ_[p] K
  let _ : MeasurableSpace K := borel K
  have : BorelSpace K := ⟨rfl⟩
  have : ProperSpace K := FiniteDimensional.proper ℚ_[p] K
  exact unitVol_muLog_logUnit_eq p K P Measure.addHaar

end LogLattice

/-! ## Identity (A) for `log_p(R_I^×)` and the first inequality of Proposition 1.4 (iii) -/

section LogVolume

variable (p : ℕ) [hp : Fact p.Prime] (K₁ K₂ : Type*) [Field K₁] [Field K₂] [Algebra ℚ_[p] K₁]
  [Algebra ℚ_[p] K₂] [FiniteDimensional ℚ_[p] K₁] [FiniteDimensional ℚ_[p] K₂]
  [Algebra ℤ_[p] K₁] [Algebra ℤ_[p] K₂] [IsScalarTower ℤ_[p] ℚ_[p] K₁]
  [IsScalarTower ℤ_[p] ℚ_[p] K₂]

omit [IsScalarTower ℤ_[p] ℚ_[p] K₁] [IsScalarTower ℤ_[p] ℚ_[p] K₂] in
/-- `tensorLogLattice` (`log_p(R_I^×)` of IUT IV page 10) is the image of
`log_p(R_1^×) ⊗_{ℤ_p} log_p(R_2^×)` in the sense of `tensorAddSpan`. -/
theorem tensorAddSpan_logUnits :
    (tensorAddSpan p K₁ K₂ (tensorLogUnits p K₁) (tensorLogUnits p K₂) :
      Set (TensorProduct ℚ_[p] K₁ K₂)) = tensorLogLattice p K₁ K₂ :=
  tensorAddSpan_coe p K₁ K₂ _ _

variable [MeasurableSpace (Fin (Module.finrank ℚ_[p] (TensorProduct ℚ_[p] K₁ K₂)) → ℚ_[p])]
  [BorelSpace (Fin (Module.finrank ℚ_[p] (TensorProduct ℚ_[p] K₁ K₂)) → ℚ_[p])]
  (μ : Measure (Fin (Module.finrank ℚ_[p] (TensorProduct ℚ_[p] K₁ K₂)) → ℚ_[p]))
  [μ.IsAddHaarMeasure]

/-- **Identity (A) of IUT IV page 14 for two factors**:
`μ^log(log_p(R_I^×)) = μ^log(log_p(R_1^×)) + μ^log(log_p(R_2^×)) + μ^log(R_I)`, where
`log_p(R_I^×)` is `tensorLogLattice`, `R_I` is `R_E = padicPacketIntegers`, the left side and the
last term are packet log-volumes normalized by `μ^log((R_I)^∼) = 0`, and `μ^log(log_p(R_i^×))` is
the log-volume of `K_i` normalized by `μ^log(R_i) = 0` (`tensorAddMuLog`). -/
theorem tensorAdd_muLog_logLattice :
    padicPacketMuLog p (TensorProduct ℚ_[p] K₁ K₂) μ (padicPacketNormalization p K₁ K₂)
        (tensorLogLattice p K₁ K₂) =
      tensorAddMuLog p K₁ (tensorLogUnits p K₁) + tensorAddMuLog p K₂ (tensorLogUnits p K₂) +
        padicPacketMuLog p (TensorProduct ℚ_[p] K₁ K₂) μ (padicPacketNormalization p K₁ K₂)
          (padicPacketIntegers p K₁ K₂) := by
  obtain ⟨k₁, h₁, h₁'⟩ := tensorAdd_logUnits_sandwich p K₁
  obtain ⟨k₂, h₂, h₂'⟩ := tensorAdd_logUnits_sandwich p K₂
  rw [← tensorAddSpan_logUnits]
  exact tensorAdd_muLog_add p K₁ K₂ μ (tensorAddLogSubmodule p K₁) (tensorAddLogSubmodule p K₂)
    k₁ k₂ h₁ h₁' h₂ h₂'

variable (P₁ : Ideal (integralClosure ℤ_[p] K₁)) [P₁.IsPrime]
  [P₁.LiesOver (IsLocalRing.maximalIdeal ℤ_[p])]
  (P₂ : Ideal (integralClosure ℤ_[p] K₂)) [P₂.IsPrime]
  [P₂.LiesOver (IsLocalRing.maximalIdeal ℤ_[p])]

/-- **IUT IV Proposition 1.4 (iii), first inequality, for two factors** (page 13, proof on
page 14). Let `I* ⊆ I = {1, 2}` be such that `e_i ≤ p − 2` for `i ∉ I*`. For every real `λ`:
`μ^log(p ^ ⌊λ − 𝔡_I − a_I⌋ · log_p(R_I^×)) ≤ (−λ + 𝔡_I + 1 + 4 |I*| / p) log p`, the packet
log-volume normalized by `μ^log((R_I)^∼) = 0`. This is `tensorLog_prop1_4_iii_lattice` without
its hypotheses `p > 2`, `e_1, e_2 ≤ p − 2`. The proof follows page 14: the floor step, identity
(A) (`tensorAdd_muLog_logLattice`), `μ^log(log_p(R_i^×)) ≤ −(1 / e_i) log p` from
Proposition 1.4 (ii), `μ^log(R_I) ≤ 0` (`tensorIdx_muLog_nonpos`), and the estimate
`∑_i (a_i − 1 / e_i) ≤ 4 |I*| / p` (`Proposition1_4.iii_first`). -/
theorem tensorAdd_prop1_4_iii_lattice (Istar : Finset (Fin 2))
    (hIstar : ∀ i, i ∉ Istar →
      (![P₁.ramificationIdx ℤ_[p], P₂.ramificationIdx ℤ_[p]] : Fin 2 → ℕ) i ≤ p - 2)
    (lam : ℝ) :
    padicPacketMuLog p (TensorProduct ℚ_[p] K₁ K₂) μ (padicPacketNormalization p K₁ K₂)
        (((p : ℚ_[p]) ^ ⌊lam - (tensorLogDiffOrder p K₁ P₁ + tensorLogDiffOrder p K₂ P₂) -
          (Proposition1_2.a p (P₁.ramificationIdx ℤ_[p]) +
            Proposition1_2.a p (P₂.ramificationIdx ℤ_[p]))⌋) • tensorLogLattice p K₁ K₂) ≤
      (-lam + (tensorLogDiffOrder p K₁ P₁ + tensorLogDiffOrder p K₂ P₂) + 1 +
        4 * Istar.card / p) * Real.log p := by
  let _ := spectralNorm.normedField ℚ_[p] K₁
  let _ := spectralNorm.normedField ℚ_[p] K₂
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.out.pos
  have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast hp.out.one_lt.le
  have hpq : (p : ℚ_[p]) ≠ 0 := by exact_mod_cast hp.out.ne_zero
  have hL : 0 < Real.log p := Real.log_pos (by exact_mod_cast hp.out.one_lt)
  obtain ⟨-, ⟨z₁, hz₁⟩, -⟩ := padicBridge_extLogUnit_image_fractionalIdeal p K₁ P₁
  obtain ⟨-, ⟨z₂, hz₂⟩, -⟩ := padicBridge_extLogUnit_image_fractionalIdeal p K₂ P₂
  have hz₁0 : z₁ ≠ 0 := by
    intro h0
    rw [h0, norm_zero] at hz₁
    exact (Real.rpow_pos_of_pos hp0 _).ne' hz₁.symm
  have hz₂0 : z₂ ≠ 0 := by
    intro h0
    rw [h0, norm_zero] at hz₂
    exact (Real.rpow_pos_of_pos hp0 _).ne' hz₂.symm
  have hN := tensorLog_normalization_measure p K₁ K₂ μ
  obtain ⟨M, hM⟩ := exists_nat_ge (tensorLogDiffOrder p K₁ P₁ + tensorLogDiffOrder p K₂ P₂ +
    (Proposition1_2.a p (P₁.ramificationIdx ℤ_[p]) +
      Proposition1_2.a p (P₂.ramificationIdx ℤ_[p])))
  have hlo : tensorLogShift p K₁ K₂ (((p : ℚ_[p]) ^ (M : ℤ)) • (1 : K₁)) 1 ⊆
      tensorLogLattice p K₁ K₂ := by
    refine tensorLog_shift_subset_lattice p K₁ K₂ P₁ P₂ ?_
    show ‖((p : ℚ_[p]) ^ (M : ℤ)) • (1 : K₁)‖ * ‖(1 : K₂)‖ ≤ _
    rw [tensorLog_norm_p_zpow_smul, norm_one, norm_one, mul_one, mul_one]
    apply Real.rpow_le_rpow_of_exponent_le hp1
    push_cast
    linarith
  have hhi := tensorLog_lattice_subset_shift p K₁ K₂ P₁ P₂ hz₁ hz₂
  have hLat := tensorLog_measure_of_subset p K₁ K₂ μ
    (smul_ne_zero (zpow_ne_zero _ hpq) one_ne_zero) one_ne_zero hz₁0 hz₂0 hlo hhi
  have h1 := packet_muLog_floor_smul_le p (TensorProduct ℚ_[p] K₁ K₂) μ
    (tensorLog_finrank_pos p K₁ K₂) (Λ := padicPacketNormalization p K₁ K₂) hN.1 hN.2.1
    hLat.1 hLat.2 (lam - (tensorLogDiffOrder p K₁ P₁ + tensorLogDiffOrder p K₂ P₂) -
      (Proposition1_2.a p (P₁.ramificationIdx ℤ_[p]) +
        Proposition1_2.a p (P₂.ramificationIdx ℤ_[p])))
  have hmu₁ : tensorAddMuLog p K₁ (tensorLogUnits p K₁) ≤
      -(1 / (P₁.ramificationIdx ℤ_[p] : ℝ)) * Real.log p := by
    rw [tensorAddMuLog_logUnits p K₁ P₁]
    have : 0 ≤ (unitVolTorsionExponent p K₁ : ℝ) /
        ((P₁.ramificationIdx ℤ_[p] : ℝ) * unitVolResidueDegree p K₁) := by positivity
    nlinarith
  have hmu₂ : tensorAddMuLog p K₂ (tensorLogUnits p K₂) ≤
      -(1 / (P₂.ramificationIdx ℤ_[p] : ℝ)) * Real.log p := by
    rw [tensorAddMuLog_logUnits p K₂ P₂]
    have : 0 ≤ (unitVolTorsionExponent p K₂ : ℝ) /
        ((P₂.ramificationIdx ℤ_[p] : ℝ) * unitVolResidueDegree p K₂) := by positivity
    nlinarith
  refine Proposition1_4.iii_first hp.out.two_le Finset.univ Istar (Finset.subset_univ _)
    ![P₁.ramificationIdx ℤ_[p], P₂.ramificationIdx ℤ_[p]] ?_ (fun i _ hi => hIstar i hi)
    ![tensorAddMuLog p K₁ (tensorLogUnits p K₁), tensorAddMuLog p K₂ (tensorLogUnits p K₂)]
    (dI := tensorLogDiffOrder p K₁ P₁ + tensorLogDiffOrder p K₂ P₂) ?_
    ((tensorAdd_muLog_logLattice p K₁ K₂ μ).trans ?_) ?_ (tensorIdx_muLog_nonpos p K₁ K₂ μ)
  · intro i
    fin_cases i
    · exact tensorLog_one_le_ramificationIdx p K₁ P₁
    · exact tensorLog_one_le_ramificationIdx p K₂ P₂
  · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]
    refine h1.trans_eq ?_
    ring
  · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]
  · intro i _
    fin_cases i
    · exact hmu₁
    · exact hmu₂

end LogVolume

