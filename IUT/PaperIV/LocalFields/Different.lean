import Mathlib

/-!
# IUT IV, Proposition 1.3 (i): the lower bound for the order of the different

Source: Mochizuki, *Inter-universal Teichmüller Theory IV*, Propositions 1.1 to 1.3, pages 9 to
12 of the April 2020 manuscript. Pages read for this file: 9 to 15. Pages checked against
rendered images: 9, 10, 11 and 12 (the definition of `𝔡_i` and the normalization of `ord` on
page 9; the statement of Proposition 1.3 (i) on pages 11 and 12).

## The statement of the paper

Page 9: `ord` is the `p`-adic valuation on `\bar ℚ_p` with `ord(p) = 1`; `R_i` is the ring of
integers of a finite extension `k_i` of `ℚ_p` and `𝔡_i ∈ ℚ_{≥ 0}` is the order `ord` of any
generator of the different ideal of `R_i` over `ℤ_p`. Page 10: `e_i` is the ramification index
of `k_i` over `ℚ_p`. Page 11: for a subfield `ℚ_p ⊆ k_0 ⊆ k_i` with ring of integers `R_0`,
different order `𝔡_0` and ramification index `e_0`, and `e_{i/0} = e_i/e_0`, Proposition 1.3 (i)
asserts `𝔡_i ≥ 𝔡_0 + (e_{i/0} - 1)/e_i`, with equality when `k_i` is tamely ramified over `k_0`
(page 12).

## What is formalized, and the normalizations chosen

The setting is that of Mathlib's different ideal: a Dedekind domain `A` with fraction field `K`,
a finite separable extension `L/K`, and the integral closure `B` of `A` in `L`; `p` is a nonzero
maximal ideal of `A` and `P` a prime of `B` over `p`. With `A = ℤ_p`, `K = ℚ_p`, `L = k_i` this
is the paper's setting (see `IUT.PaperIV.LocalFields.Padic`).

* `differentExponent A B P` is the multiplicity of `P` in the different ideal `𝔇_{B/A}`
  (Mathlib's `differentIdeal`), a natural number.
* `ramificationIdx` is Mathlib's `Ideal.ramificationIdx P A`, the ramification index `e` of `P`
  over `p`.
* `differentOrder A B P = differentExponent A B P / e`, a real number. This is the paper's
  normalization: if `p` is generated by an element `ϖ` with `ord(ϖ) = 1` (for `A = ℤ_p`, the
  element `p`), then `p·B_P = P^e·B_P`, so a uniformizer of `B_P` has `ord = 1/e`, and a
  generator of `𝔇_{B/A}·B_P` has `ord = differentExponent/e`. The paper writes `ord` of a
  generator of the different of `R_i`, which presupposes that this ideal is principal; it is
  when `R_i` is local, which holds for the ring of integers of a finite extension of `ℚ_p`. That
  locality is not proved here, so every statement below is made for every prime `P` over `p`;
  when `P` is the only one, `differentOrder` is the paper's `𝔡_i`.

Proved, from Mathlib's `pow_sub_one_dvd_differentIdeal_aux` (`P^{e-1}` divides the different)
and the transitivity of the different (`differentIdeal_eq_differentIdeal_mul_differentIdeal`):

* `ramificationIdx_sub_one_le_differentExponent`: `e - 1 ≤ differentExponent`;
* `differentOrder_ge`: `(e - 1)/e ≤ differentOrder`, i.e. Proposition 1.3 (i) for `k_0 = ℚ_p`
  (where `𝔡_0 = 0`, `e_0 = 1`);
* `differentOrder_ge_tower`: for a tower `A ⊆ B ⊆ C` of such rings (the paper's
  `ℤ_p ⊆ R_0 ⊆ R_i`) and primes `P ⊆ C` over `P₀ ⊆ B` over `p`,
  `differentOrder A C P ≥ differentOrder A B P₀ + (e_{P/P₀} - 1)/e_{P/p}`, which is the
  inequality of Proposition 1.3 (i) with `e_{i/0} = e_{P/P₀}` and `e_i = e_{P/p}`
  (`e_{P/p} = e_{P₀/p}·e_{P/P₀}` by `Ideal.ramificationIdx_tower`).

Not formalized: the equality in the tamely ramified case (Mathlib, at the pinned version, has no
statement computing the exact exponent of the different in the tame case; only the bound and the
characterization `P ∣ 𝔇 ↔ P` ramified, `dvd_differentIdeal_iff`, are available), Proposition
1.3 (ii), and the uniqueness of `P` over `p` for `ℤ_p`.
-/

open Ideal nonZeroDivisors

namespace IUT.PaperIV.LocalFields

/-- The exponent of the prime `P` in the different ideal of `B` over `A`: the multiplicity of `P`
in `differentIdeal A B` (with Mathlib's convention that `multiplicity` is `0` when it is
infinite, which does not occur for a nonzero prime and the nonzero different). -/
noncomputable def differentExponent (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    [IsDomain A] [IsIntegrallyClosed A] [IsDedekindDomain B] [Module.IsTorsionFree A B]
    (P : Ideal B) : ℕ :=
  multiplicity P (differentIdeal A B)

/-- The paper's order `𝔡` of the different at `P`, normalized so that `ord(ϖ) = 1` for a
generator `ϖ` of the prime of `A` below `P`: the exponent of `P` in the different divided by the
ramification index of `P` over `A`. -/
noncomputable def differentOrder (A B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    [IsDomain A] [IsIntegrallyClosed A] [IsDedekindDomain B] [Module.IsTorsionFree A B]
    (P : Ideal B) : ℝ :=
  (differentExponent A B P : ℝ) / (P.ramificationIdx A : ℝ)

/-- The ramification index of a prime over a nonzero maximal ideal of a Dedekind domain is
positive. -/
theorem ramificationIdx_pos_of_liesOver {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [IsDedekindDomain A] [IsDedekindDomain B] [Module.IsTorsionFree A B] {p : Ideal A}
    (hp : p ≠ ⊥) (P : Ideal B) [P.IsPrime] [P.LiesOver p] : 0 < P.ramificationIdx A :=
  ramificationIdx_pos_of_isDedekindDomain' P hp

section Base

variable (A K L B : Type*) [CommRing A] [Field K] [CommRing B] [Field L]
  [Algebra A K] [Algebra B L] [Algebra A B] [Algebra K L] [Algebra A L]
  [IsScalarTower A K L] [IsScalarTower A B L] [IsFractionRing A K]
  [IsDedekindDomain A] [IsDedekindDomain B] [Module.IsTorsionFree A B]
  [FiniteDimensional K L] [Algebra.IsSeparable K L] [IsIntegralClosure B A L]

include K L

/-- The different ideal of the integral closure `B` of `A` in a finite separable extension `L`
of `K = Frac(A)` is nonzero. -/
theorem differentIdeal_ne_bot_of_isIntegralClosure : differentIdeal A B ≠ ⊥ := by
  have : IsFractionRing B L := IsIntegralClosure.isFractionRing_of_finite_extension A K L B
  intro h
  have h2 := coeIdeal_differentIdeal A K L B
  rw [h, FractionalIdeal.coeIdeal_bot] at h2
  exact FractionalIdeal.dual_ne_zero A K (one_ne_zero (α := FractionalIdeal B⁰ L))
    (inv_eq_zero.mp h2.symm)

/-- `e - 1 ≤` the exponent of `P` in the different, where `e` is the ramification index of `P`
over the nonzero maximal ideal `p` of `A`. -/
theorem ramificationIdx_sub_one_le_differentExponent {p : Ideal A} [p.IsMaximal] (hp : p ≠ ⊥)
    (P : Ideal B) [P.IsPrime] [P.LiesOver p] :
    P.ramificationIdx A - 1 ≤ differentExponent A B P := by
  have : IsFractionRing B L := IsIntegralClosure.isFractionRing_of_finite_extension A K L B
  have : Module.Finite A B := IsIntegralClosure.finite A K L B
  have hpS : p.map (algebraMap A B) ≠ ⊥ := map_ne_bot_of_ne_bot hp
  have hP0 : P ≠ ⊥ := ne_bot_of_le_ne_bot hpS (map_le_of_le_comap (P.over_def p).le)
  have hdvd : P ^ (P.ramificationIdx A) ∣ p.map (algebraMap A B) := by
    rw [IsDedekindDomain.ramificationIdx_eq_multiplicity p P hpS]
    exact pow_multiplicity_dvd _ _
  have h := pow_sub_one_dvd_differentIdeal_aux A K L P hp hdvd
  have hPr : Prime P := prime_of_isPrime hP0 inferInstance
  exact (FiniteMultiplicity.of_prime_left hPr
    (differentIdeal_ne_bot_of_isIntegralClosure A K L B)).le_multiplicity_of_pow_dvd h

/-- **Proposition 1.3 (i) for `k_0 = ℚ_p`** in the setting of Dedekind domains:
`(e - 1)/e ≤ 𝔡`, where `e` is the ramification index of `P` over `p` and `𝔡 = differentOrder`. -/
theorem differentOrder_ge {p : Ideal A} [p.IsMaximal] (hp : p ≠ ⊥) (P : Ideal B) [P.IsPrime]
    [P.LiesOver p] :
    ((P.ramificationIdx A : ℝ) - 1) / P.ramificationIdx A ≤ differentOrder A B P := by
  have he := ramificationIdx_pos_of_liesOver hp P
  have hb := ramificationIdx_sub_one_le_differentExponent A K L B hp P
  have he' : (0 : ℝ) < P.ramificationIdx A := by exact_mod_cast he
  have h1 : ((P.ramificationIdx A : ℝ) - 1) ≤ differentExponent A B P := by
    have : ((P.ramificationIdx A - 1 : ℕ) : ℝ) ≤ differentExponent A B P := by exact_mod_cast hb
    rwa [Nat.cast_sub (by omega), Nat.cast_one] at this
  exact div_le_div_of_nonneg_right h1 he'.le

end Base

section Tower

/-! The tower `A ⊆ B ⊆ C` with fraction fields `K ⊆ L₀ ⊆ M`: the paper's `ℤ_p ⊆ R_0 ⊆ R_i`
inside `ℚ_p ⊆ k_0 ⊆ k_i`. -/

variable (A K B L₀ C M : Type*) [CommRing A] [Field K] [CommRing B] [Field L₀]
  [CommRing C] [Field M]
  [Algebra A K] [Algebra A B] [Algebra A C] [Algebra A L₀] [Algebra A M]
  [Algebra B C] [Algebra B L₀] [Algebra B M] [Algebra C M]
  [Algebra K L₀] [Algebra K M] [Algebra L₀ M]
  [IsScalarTower A K L₀] [IsScalarTower A B L₀] [IsScalarTower A K M] [IsScalarTower A C M]
  [IsScalarTower B L₀ M] [IsScalarTower B C M] [IsScalarTower A B C]
  [IsFractionRing A K]
  [IsDedekindDomain A] [IsDedekindDomain B] [IsDedekindDomain C]
  [Module.IsTorsionFree A B] [Module.IsTorsionFree A C] [Module.IsTorsionFree B C]
  [FiniteDimensional K L₀] [Algebra.IsSeparable K L₀] [IsIntegralClosure B A L₀]
  [FiniteDimensional K M] [Algebra.IsSeparable K M] [IsIntegralClosure C A M]
  [FiniteDimensional L₀ M] [Algebra.IsSeparable L₀ M] [IsIntegralClosure C B M]

include K L₀ M

/-- Transitivity of the different in the tower: `𝔇_{C/A} = 𝔇_{C/B}·𝔇_{B/A}C`. This is Mathlib's
`differentIdeal_eq_differentIdeal_mul_differentIdeal`, whose separability hypothesis on the
fraction rings is derived here from the separability of `M/K`. -/
theorem differentIdeal_tower_eq :
    differentIdeal A C = differentIdeal B C * (differentIdeal A B).map (algebraMap B C) := by
  have : IsFractionRing C M := IsIntegralClosure.isFractionRing_of_finite_extension A K M C
  have : Module.Finite A B := IsIntegralClosure.finite A K L₀ B
  have : Module.Finite A C := IsIntegralClosure.finite A K M C
  have : IsFractionRing B L₀ := IsIntegralClosure.isFractionRing_of_finite_extension A K L₀ B
  have : Module.Finite B C := IsIntegralClosure.finite B L₀ M C
  let := FractionRing.liftAlgebra A (FractionRing C)
  have : IsScalarTower A (FractionRing A) (FractionRing C) :=
    FractionRing.isScalarTower_liftAlgebra _ _
  have H : RingHom.comp (algebraMap (FractionRing A) (FractionRing C))
      ↑(FractionRing.algEquiv A K).symm.toRingEquiv =
        RingHom.comp ↑(FractionRing.algEquiv C M).symm.toRingEquiv (algebraMap K M) := by
    apply IsLocalization.ringHom_ext A⁰
    ext
    simp only [RingHom.coe_comp, RingHom.coe_coe,
      AlgEquiv.coe_toRingEquiv, Function.comp_apply, AlgEquiv.commutes,
      ← IsScalarTower.algebraMap_apply]
    rw [IsScalarTower.algebraMap_apply A C M, AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply]
  have : Algebra.IsSeparable (FractionRing A) (FractionRing C) :=
    Algebra.IsSeparable.of_equiv_equiv _ _ H
  exact differentIdeal_eq_differentIdeal_mul_differentIdeal A B C

/-- The exponents of the different in the tower: for primes `P ⊆ C` over `P₀ ⊆ B` over `p ⊆ A`,
`differentExponent A C P = differentExponent B C P + e_{P/P₀}·differentExponent A B P₀`. -/
theorem differentExponent_tower {p : Ideal A} [p.IsMaximal] (hp : p ≠ ⊥) (P₀ : Ideal B)
    [P₀.IsPrime] [P₀.LiesOver p] (P : Ideal C) [P.IsPrime] [P.LiesOver P₀] :
    differentExponent A C P =
      differentExponent B C P + P.ramificationIdx B * differentExponent A B P₀ := by
  have hP₀ : P₀ ≠ ⊥ := ne_bot_of_liesOver_of_ne_bot hp P₀
  have hP : P ≠ ⊥ := ne_bot_of_liesOver_of_ne_bot hP₀ P
  have hP₀r : Prime P₀ := prime_of_isPrime hP₀ inferInstance
  have hPr : Prime P := prime_of_isPrime hP inferInstance
  have hAB := differentIdeal_ne_bot_of_isIntegralClosure A K L₀ B
  have hAC := differentIdeal_ne_bot_of_isIntegralClosure A K M C
  have hmap : (differentIdeal A B).map (algebraMap B C) ≠ ⊥ := map_ne_bot_of_ne_bot hAB
  have hprod := differentIdeal_tower_eq A K B L₀ C M
  have hfin : FiniteMultiplicity P (differentIdeal B C * (differentIdeal A B).map
      (algebraMap B C)) := FiniteMultiplicity.of_prime_left hPr (hprod ▸ hAC)
  have hmul := multiplicity_mul hPr hfin
  have hem := IsDedekindDomain.emultiplicity_map_eq_ramificationIdx'_mul hAB hP₀r.irreducible
    hPr.irreducible hP (v := P₀) (w := P)
  rw [(FiniteMultiplicity.of_prime_left hPr hmap).emultiplicity_eq_multiplicity,
    (FiniteMultiplicity.of_prime_left hP₀r hAB).emultiplicity_eq_multiplicity,
    ramificationIdx'_eq_ramificationIdx P₀ P hP₀] at hem
  have hem' : multiplicity P ((differentIdeal A B).map (algebraMap B C)) =
      P.ramificationIdx B * multiplicity P₀ (differentIdeal A B) := by
    exact_mod_cast hem
  unfold differentExponent
  rw [hprod, hmul, hem']

/-- **Proposition 1.3 (i), the inequality** (pages 11 and 12), in the setting of Dedekind
domains: for primes `P ⊆ C` over `P₀ ⊆ B` over the nonzero maximal ideal `p ⊆ A`,
`𝔡_i ≥ 𝔡_0 + (e_{i/0} - 1)/e_i`, with `𝔡_i = differentOrder A C P`,
`𝔡_0 = differentOrder A B P₀`, `e_{i/0} = e_{P/P₀}` and `e_i = e_{P/p}`. -/
theorem differentOrder_ge_tower {p : Ideal A} [p.IsMaximal] (hp : p ≠ ⊥) (P₀ : Ideal B)
    [P₀.IsPrime] [P₀.LiesOver p] (P : Ideal C) [P.IsPrime] [P.LiesOver P₀] :
    differentOrder A B P₀ + ((P.ramificationIdx B : ℝ) - 1) / P.ramificationIdx A ≤
      differentOrder A C P := by
  have hP₀ : P₀ ≠ ⊥ := ne_bot_of_liesOver_of_ne_bot hp P₀
  have : P₀.IsMaximal := IsPrime.isMaximal inferInstance hP₀
  have : IsFractionRing B L₀ := IsIntegralClosure.isFractionRing_of_finite_extension A K L₀ B
  have : P.LiesOver p := LiesOver.trans P P₀ p
  have htow : P.ramificationIdx A = P₀.ramificationIdx A * P.ramificationIdx B :=
    ramificationIdx_tower P₀ P
  have he₀ := ramificationIdx_pos_of_liesOver hp P₀
  have he' := ramificationIdx_pos_of_liesOver hP₀ P
  have hb := ramificationIdx_sub_one_le_differentExponent B L₀ M C hP₀ P
  have hexp := differentExponent_tower A K B L₀ C M hp P₀ P
  unfold differentOrder
  rw [hexp, htow]
  set e₀ := P₀.ramificationIdx A
  set e₁ := P.ramificationIdx B
  set m₀ := differentExponent A B P₀
  set m₁ := differentExponent B C P
  have he₀r : (0 : ℝ) < e₀ := by exact_mod_cast he₀
  have he₁r : (0 : ℝ) < e₁ := by exact_mod_cast he'
  have hb' : (e₁ : ℝ) - 1 ≤ m₁ := by
    have : ((e₁ - 1 : ℕ) : ℝ) ≤ m₁ := by exact_mod_cast hb
    rwa [Nat.cast_sub (by omega), Nat.cast_one] at this
  push_cast
  rw [div_add_div _ _ he₀r.ne' (by positivity), div_le_div_iff₀ (by positivity) (by positivity)]
  have hpos : (0 : ℝ) ≤ e₀ * (e₀ * e₁) := by positivity
  nlinarith [mul_le_mul_of_nonneg_left hb' hpos]

end Tower

end IUT.PaperIV.LocalFields
