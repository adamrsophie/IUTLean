import IUT.PaperIV.LocalFields.TensorLogShellMany
import IUT.PaperIV.LocalFields.TensorAdditivity

/-!
# Tensor products of `n` lattices and identity (A) (IUT IV, Proposition 1.4)

Source: IUT IV, Proposition 1.4 (page 13) and its proof (page 14), with the notation of
Propositions 1.1 and 1.2. Pages read for this file: 10, 13 and 14. Pages
checked against rendered images: 10, 13 and 14.

For finite extensions `K_i`, `i ∈ I`, of `ℚ_p` (abstract fields, `I` any finite type), the image
of `⊗_{i, ℤ_p} A_i` in the packet `⊗_{i, ℚ_p} K_i` is `tamSpan` (the additive span of the
`a · (⊗_i x_i)`, `a ∈ ℤ_p`, `x_i ∈ A_i`). This file proves:

* the one-factor replacement lemma (`tamReplace_map`, `tam_relIndex_replace`): replacing the
  factor `N` at `s` by `N'` multiplies the index by `[N' : N] ^ (∏_{i ≠ s} [K_i : ℚ_p])`, through
  coordinates in a product basis of `⊗_{i ≠ s} K_i` and the split
  `⊗_i K_i ≅ K_s ⊗ (⊗_{i ≠ s} K_i)` (`tdManySplitMap`);
* the index of a tensor product of `n` lattices (`tam_relIndex`), generalizing
  `tensorAdd_relIndex`: `[⊗_i M_i : ⊗_i L_i] = ∏_s [M_s : L_s] ^ (∏_{i ≠ s} [K_i : ℚ_p])`;
* `R_I` is the image of `⊗_{ℤ_p} R_i`, contains `p ^ k · (R_I)^∼`, and is open and compact of
  positive finite Haar measure in coordinates (`tamSpan_integers`, `tam_pow_smul_mem_integers`,
  `tam_integers_coord`);
* identity (A) of page 14 for any finite number of factors, for lattices (`tam_muLog_add`) and for
  `log_p(R_I^×)` (`tam_muLog_logLattice`), with Proposition 1.4 (ii) inserted
  (`tam_prop1_4_ii`);
* the first inequality of Proposition 1.4 (iii) for any finite number of factors
  (`tam_prop1_4_iii_first`); the inequality `𝔡_I + a_I ≥ |I|` is `padic_dI_add_aI_ge`.

Readings: the tensor products over `ℤ_p` are taken as their images in the packet over `ℚ_p`
(for the rings of integers the map is injective by `packetId_map_injective`, not used here; for
the logarithm lattices injectivity is not proved); `μ^log` on the packet is `padicPacketMuLog`
normalized by `μ^log((R_I)^∼) = 0`, and on `K_i` it is `tensorAddMuLog` normalized by
`μ^log(R_i) = 0`. The second inequality of Proposition 1.4 (iii) for `n` factors is not proved
here.
-/

open MeasureTheory IUT.Prerequisites.PadicVolume
open scoped Pointwise

namespace IUT.PaperIV.LocalFields

/-! ## Coordinates in a basis of the right factor of a binary tensor product -/

section Coord

variable (p : ℕ) [hp : Fact p.Prime] (K₀ M : Type*) [AddCommGroup K₀] [Module ℚ_[p] K₀]
  [AddCommGroup M] [Module ℚ_[p] M]

/-- The map `x ↦ ∑_r x_r ⊗ c_r` from `K₀ ^ κ` to `K₀ ⊗ M` for a family `c` of `M`. -/
noncomputable def tamCoord {κ : Type*} [Fintype κ] (c : κ → M) :
    (κ → K₀) →+ TensorProduct ℚ_[p] K₀ M where
  toFun x := ∑ r, TensorProduct.tmul ℚ_[p] (x r) (c r)
  map_zero' := by simp
  map_add' x y := by simp [TensorProduct.add_tmul, Finset.sum_add_distrib]

/-- For a `ℚ_p`-basis `c` of `M`, `x ↦ ∑_r x_r ⊗ c_r` is injective. -/
theorem tamCoord_injective {κ : Type*} [Fintype κ] (c : Module.Basis κ ℚ_[p] M) :
    Function.Injective (tamCoord p K₀ M c) := by
  classical
  have key : ∀ (x : κ → K₀) (j : κ),
      TensorProduct.equivFinsuppOfBasisRight c (tamCoord p K₀ M c x) j = x j := by
    intro x j
    show TensorProduct.equivFinsuppOfBasisRight c (∑ r, TensorProduct.tmul ℚ_[p] (x r) (c r)) j = _
    rw [map_sum, Finsupp.finsetSum_apply]
    simp [Finsupp.single_apply]
  exact fun x y h => funext fun j => by rw [← key x j, ← key y j, h]

end Coord

/-! ## The image of `⊗_{ℤ_p} A_i` in the packet -/

section Span

variable (p : ℕ) [hp : Fact p.Prime] {ι : Type} [Fintype ι] [DecidableEq ι] (K : ι → Type)
  [∀ i, Field (K i)] [∀ i, Algebra ℚ_[p] (K i)]

/-- **The image of `⊗_{i, ℤ_p} A_i` in the packet `⊗_{i, ℚ_p} K_i`** for subsets `A_i ⊆ K_i`: the
additive subgroup generated by the `a · (⊗_i x_i)` with `a ∈ ℤ_p` and every `x_i ∈ A_i`. For two
factors this is `tensorAddSpan`; for `A_i = log_p(R_i^×)` it is `tlsmLattice` (`tam_span_logUnits`).
-/
noncomputable def tamSpan (A : ∀ i, Set (K i)) : AddSubgroup (PiTensorProduct ℚ_[p] K) :=
  AddSubgroup.closure {w | ∃ (a : ℤ_[p]) (x : ∀ i, K i), (∀ i, x i ∈ A i) ∧
    w = (a : ℚ_[p]) • PiTensorProduct.tprod ℚ_[p] x}

omit [Fintype ι] [DecidableEq ι] in
/-- The carrier of `tamSpan` is the additive submonoid generated by the same elements. -/
theorem tamSpan_coe (A : ∀ i, Set (K i)) :
    (tamSpan p K A : Set (PiTensorProduct ℚ_[p] K)) =
      ((AddSubmonoid.closure {w | ∃ (a : ℤ_[p]) (x : ∀ i, K i), (∀ i, x i ∈ A i) ∧
        w = (a : ℚ_[p]) • PiTensorProduct.tprod ℚ_[p] x} :
          AddSubmonoid (PiTensorProduct ℚ_[p] K)) : Set (PiTensorProduct ℚ_[p] K)) := by
  rw [← AddSubgroup.coe_toAddSubmonoid, tamSpan, AddSubgroup.closure_toAddSubmonoid]
  congr 2
  refine Set.union_eq_left.2 ?_
  intro w hw
  obtain ⟨a, x, hx, hw⟩ := Set.mem_neg.1 hw
  refine ⟨-a, x, hx, ?_⟩
  rw [PadicInt.coe_neg, neg_smul, ← hw, neg_neg]

omit [Fintype ι] [DecidableEq ι] in
/-- `tamSpan` is monotone. -/
theorem tamSpan_mono {A B : ∀ i, Set (K i)} (h : ∀ i, A i ⊆ B i) :
    tamSpan p K A ≤ tamSpan p K B := by
  refine AddSubgroup.closure_mono ?_
  rintro _ ⟨a, x, hx, rfl⟩
  exact ⟨a, x, fun i => h i (hx i), rfl⟩

end Span

/-! ## The one-factor replacement lemma and the index of `⊗_{i ∈ I} L_i` -/

section Index

variable (p : ℕ) [hp : Fact p.Prime] {ι : Type} [Fintype ι] [DecidableEq ι] (K : ι → Type)
  [∀ i, Field (K i)] [∀ i, Algebra ℚ_[p] (K i)] [∀ i, FiniteDimensional ℚ_[p] (K i)]
  [∀ i, Algebra ℤ_[p] (K i)] [∀ i, IsScalarTower ℤ_[p] ℚ_[p] (K i)]

/-- The map `x ↦ e(∑_r x_r ⊗ C_r)` from `K_s ^ κ` to the packet, for a family `C` of
`⊗_{i ≠ s} K_i` and `e : K_s ⊗ (⊗_{i ≠ s} K_i) ≅ ⊗_i K_i` (`tdManySplitMap`). -/
noncomputable def tamReplace (s : ι) {κ : Type*} [Fintype κ]
    (C : κ → PiTensorProduct ℚ_[p] (fun i : {i // i ≠ s} => K i)) :
    (κ → K s) →+ PiTensorProduct ℚ_[p] K :=
  (tdManySplitMap p K s).toLinearMap.toAddMonoidHom.comp (tamCoord p (K s) _ C)

omit [∀ i, Algebra ℤ_[p] (K i)] [∀ i, IsScalarTower ℤ_[p] ℚ_[p] (K i)] in
/-- `tamReplace` is injective for a basis `C`. -/
theorem tamReplace_injective (s : ι) {κ : Type*} [Fintype κ]
    (C : Module.Basis κ ℚ_[p] (PiTensorProduct ℚ_[p] (fun i : {i // i ≠ s} => K i))) :
    Function.Injective (tamReplace p K s C) :=
  (tdMany_splitMap_bijective p K s).1.comp (tamCoord_injective p (K s) _ C)

omit [Fintype ι] [∀ i, FiniteDimensional ℚ_[p] (K i)] [∀ i, Algebra ℤ_[p] (K i)]
  [∀ i, IsScalarTower ℤ_[p] ℚ_[p] (K i)] in
/-- The pure tensor `⊗_i y_i` is `e(y_s ⊗ (⊗_{i ≠ s} y_i))`. -/
theorem tam_splitMap_tprod (s : ι) (y : ∀ i, K i) :
    tdManySplitMap p K s (TensorProduct.tmul ℚ_[p] (y s)
        (PiTensorProduct.tprod ℚ_[p] (fun i : {i // i ≠ s} => y i))) =
      PiTensorProduct.tprod ℚ_[p] y := by
  rw [tdMany_splitMap_tmul]
  congr 1
  funext j
  by_cases h : j = s
  · subst h
    simp
  · simp [h]

omit [∀ i, FiniteDimensional ℚ_[p] (K i)] in
/-- **The one-factor replacement lemma**: let `s ∈ I`, and for `i ≠ s` let `c_i` be a
`ℚ_p`-basis of `K_i` lying in `A_i` whose `ℤ_p`-span contains `A_i`. Then `tamReplace` for the
product basis `C = ⊗_{i ≠ s} c_i` maps `N ^ κ` onto `tamSpan` of the family with `N` at `s` and
`A_i` at `i ≠ s`, for every `ℤ_p`-submodule `N` of `K_s`. -/
theorem tamReplace_map (s : ι) (A : ∀ i, Set (K i)) {n : {i // i ≠ s} → Type}
    [∀ i, Fintype (n i)] [∀ i, DecidableEq (n i)]
    (c : ∀ i : {i // i ≠ s}, Module.Basis (n i) ℚ_[p] (K i))
    (hc : ∀ (i : {i // i ≠ s}) k, c i k ∈ A i)
    (hA : ∀ i : {i // i ≠ s}, ∀ y ∈ A i, ∃ d : n i → ℤ_[p], y = ∑ k, (d k : ℚ_[p]) • c i k)
    (N : Submodule ℤ_[p] (K s)) :
    (AddSubgroup.pi Set.univ fun _ : (∀ i, n i) => N.toAddSubgroup).map
        (tamReplace p K s (Basis.piTensorProduct c)) =
      tamSpan p K (Function.update A s (N : Set (K s))) := by
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    show (tdManySplitMap p K s) (∑ r, TensorProduct.tmul ℚ_[p] (x r)
      (Basis.piTensorProduct c r)) ∈ _
    rw [map_sum]
    refine AddSubgroup.sum_mem _ fun r _ => AddSubgroup.subset_closure ⟨1,
      Pi.mulSingle s (x r) * fun j => if h : j ≠ s then c ⟨j, h⟩ (r ⟨j, h⟩) else 1,
      fun j => ?_, ?_⟩
    · by_cases h : j = s
      · subst h
        simpa using hx r (Set.mem_univ r)
      · simpa [h, Pi.mulSingle_eq_of_ne h, Function.update_of_ne h] using hc ⟨j, h⟩ (r ⟨j, h⟩)
    · rw [Basis.piTensorProduct_apply, tdMany_splitMap_tmul]
      simp
  · refine (AddSubgroup.closure_le _).2 ?_
    rintro _ ⟨a, y, hy, rfl⟩
    have hys : y s ∈ N := by simpa using hy s
    have hyi : ∀ i : {i // i ≠ s}, y i ∈ A i := fun i => by
      simpa [Function.update_of_ne i.2] using hy i
    choose d hd using fun i : {i // i ≠ s} => hA i (y i) (hyi i)
    set C := Basis.piTensorProduct c
    have hrepr : ∀ r, C.repr (PiTensorProduct.tprod ℚ_[p] (fun i : {i // i ≠ s} => y i)) r =
        ∏ i, ((d i (r i) : ℤ_[p]) : ℚ_[p]) := by
      intro r
      rw [Basis.piTensorProduct_repr_tprod_apply]
      refine Finset.prod_congr rfl fun i _ => ?_
      rw [hd i, Module.Basis.repr_sum_self]
    refine ⟨fun r => ((a : ℚ_[p]) * ∏ i, ((d i (r i) : ℤ_[p]) : ℚ_[p])) • y s,
      fun r _ => ?_, ?_⟩
    · show ((a : ℚ_[p]) * ∏ i, ((d i (r i) : ℤ_[p]) : ℚ_[p])) • y s ∈ N
      have hq : ((a : ℚ_[p]) * ∏ i, ((d i (r i) : ℤ_[p]) : ℚ_[p])) =
          algebraMap ℤ_[p] ℚ_[p] (a * ∏ i, d i (r i)) := by
        rw [map_mul, map_prod]
        rfl
      rw [hq, algebraMap_smul]
      exact N.smul_mem _ hys
    · show (tdManySplitMap p K s) (∑ r, TensorProduct.tmul ℚ_[p]
        (((a : ℚ_[p]) * ∏ i, ((d i (r i) : ℤ_[p]) : ℚ_[p])) • y s) (C r)) = _
      rw [← tam_splitMap_tprod p K s y, ← C.sum_repr
        (PiTensorProduct.tprod ℚ_[p] (fun i : {i // i ≠ s} => y i)), TensorProduct.tmul_sum,
        map_sum, map_sum, Finset.smul_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [hrepr r, TensorProduct.tmul_smul, ← TensorProduct.smul_tmul']
      simp only [map_smul, smul_smul]

/-- `∏_{i ≠ s} [K_i : ℚ_p]`, the exponent of the replacement lemma. -/
noncomputable def tamDegOff (s : ι) : ℕ :=
  ∏ i : {i // i ≠ s}, Module.finrank ℚ_[p] (K i)

/-- **The index after replacing one factor**: for full `ℤ_p`-lattices `A_i` of `K_i`
(finitely generated, spanning `K_i` over `ℚ_p`), `i ≠ s`, and `ℤ_p`-submodules `N`, `N'` of
`K_s`, `[A' : A] = [N' : N] ^ (∏_{i ≠ s} [K_i : ℚ_p])`, where `A`, `A'` are the images of the
tensor products with `N`, `N'` at `s` and `A_i` elsewhere (relative indices of additive
subgroups, `0` when infinite). -/
theorem tam_relIndex_replace (s : ι) (A : ∀ i, Submodule ℤ_[p] (K i))
    (hfg : ∀ i, i ≠ s → (A i).FG)
    (hsp : ∀ i, i ≠ s → Submodule.span ℚ_[p] (A i : Set (K i)) = ⊤)
    (N N' : Submodule ℤ_[p] (K s)) :
    (tamSpan p K (Function.update (fun i => (A i : Set (K i))) s (N : Set (K s)))).relIndex
        (tamSpan p K (Function.update (fun i => (A i : Set (K i))) s (N' : Set (K s)))) =
      N.toAddSubgroup.relIndex N'.toAddSubgroup ^ tamDegOff p K s := by
  have hb := fun i : {i // i ≠ s} =>
    tensorAdd_exists_basis p (K i) (A i) (hfg i i.2) (hsp i i.2)
  choose n c hc hA using hb
  rw [← tamReplace_map p K s (fun i => (A i : Set (K i))) c hc hA N,
    ← tamReplace_map p K s (fun i => (A i : Set (K i))) c hc hA N',
    AddSubgroup.relIndex_map_map_of_injective _ _
      (tamReplace_injective p K s (Basis.piTensorProduct c)),
    tensorAdd_relIndex_pi, tamDegOff, Fintype.card_pi]
  refine congrArg _ (Finset.prod_congr rfl fun i _ => ?_)
  rw [Fintype.card_fin, Module.finrank_eq_card_basis (c i), Fintype.card_fin]

/-- The hybrid family: `M_i` for `i ∈ T`, `L_i` otherwise. -/
noncomputable def tamHybrid (L M : ∀ i, Submodule ℤ_[p] (K i)) (T : Finset ι) :
    ∀ i, Submodule ℤ_[p] (K i) :=
  fun i => if i ∈ T then M i else L i

/-- **The index of a tensor product of `n` lattices** (generalizing `tensorAdd_relIndex`): for
full `ℤ_p`-lattices `L_i ≤ M_i` of `K_i` (finitely generated, spanning over `ℚ_p`),
`[⊗_i M_i : ⊗_i L_i] = ∏_s [M_s : L_s] ^ (∏_{i ≠ s} [K_i : ℚ_p])`, the tensor products being
their images in the packet (relative indices of additive subgroups, `0` when infinite). -/
theorem tam_relIndex (L M : ∀ i, Submodule ℤ_[p] (K i)) (hLM : ∀ i, L i ≤ M i)
    (hLfg : ∀ i, (L i).FG) (hLsp : ∀ i, Submodule.span ℚ_[p] (L i : Set (K i)) = ⊤)
    (hMfg : ∀ i, (M i).FG) (hMsp : ∀ i, Submodule.span ℚ_[p] (M i : Set (K i)) = ⊤) :
    (tamSpan p K (fun i => (L i : Set (K i)))).relIndex
        (tamSpan p K (fun i => (M i : Set (K i)))) =
      ∏ s, (L s).toAddSubgroup.relIndex (M s).toAddSubgroup ^ tamDegOff p K s := by
  have key : ∀ T : Finset ι, (tamSpan p K (fun i => (L i : Set (K i)))).relIndex
      (tamSpan p K (fun i => (tamHybrid p K L M T i : Set (K i)))) =
      ∏ s ∈ T, (L s).toAddSubgroup.relIndex (M s).toAddSubgroup ^ tamDegOff p K s := by
    intro T
    induction T using Finset.induction_on with
    | empty =>
      simp only [tamHybrid, Finset.notMem_empty, ite_false, Finset.prod_empty]
      exact AddSubgroup.relIndex_self _
    | @insert s T hs ih =>
      have hfg : ∀ i, (tamHybrid p K L M T i).FG := fun i => by
        unfold tamHybrid
        split_ifs
        exacts [hMfg i, hLfg i]
      have hsp : ∀ i, Submodule.span ℚ_[p] (tamHybrid p K L M T i : Set (K i)) = ⊤ :=
        fun i => by
          unfold tamHybrid
          split_ifs
          exacts [hMsp i, hLsp i]
      have hT : (fun i => (tamHybrid p K L M T i : Set (K i))) =
          Function.update (fun i => (tamHybrid p K L M T i : Set (K i))) s (L s : Set (K s)) := by
        funext i
        by_cases h : i = s
        · subst h
          simp [tamHybrid, hs]
        · rw [Function.update_of_ne h]
      have hT' : (fun i => (tamHybrid p K L M (insert s T) i : Set (K i))) =
          Function.update (fun i => (tamHybrid p K L M T i : Set (K i))) s (M s : Set (K s)) := by
        funext i
        by_cases h : i = s
        · subst h
          simp [tamHybrid]
        · rw [Function.update_of_ne h]
          simp [tamHybrid, h]
      have hle : ∀ T : Finset ι, ∀ i, (L i : Set (K i)) ⊆ (tamHybrid p K L M T i : Set (K i)) :=
        fun T i => by
          unfold tamHybrid
          split_ifs
          exacts [hLM i, le_rfl]
      have hle' : ∀ i, (tamHybrid p K L M T i : Set (K i)) ⊆
          (tamHybrid p K L M (insert s T) i : Set (K i)) := fun i => by
        unfold tamHybrid
        split_ifs with h1 h2
        · exact le_rfl
        · exact absurd (Finset.mem_insert_of_mem h1) h2
        · exact SetLike.coe_subset_coe.2 (hLM i)
        · exact le_rfl
      rw [Finset.prod_insert hs, ← AddSubgroup.relIndex_mul_relIndex _ _ _
        (tamSpan_mono p K (hle T)) (tamSpan_mono p K hle'), ih, mul_comm]
      congr 1
      rw [hT', show tamSpan p K (fun i => (tamHybrid p K L M T i : Set (K i))) =
        tamSpan p K (Function.update (fun i => (tamHybrid p K L M T i : Set (K i))) s
          (L s : Set (K s))) from congrArg _ hT]
      exact tam_relIndex_replace p K s (tamHybrid p K L M T) (fun i _ => hfg i)
        (fun i _ => hsp i) (L s) (M s)
  have h := key Finset.univ
  simp only [tamHybrid, Finset.mem_univ, ite_true] at h
  exact h

end Index

/-! ## Scaling, `R_I`, and the coordinates of `R_I` -/

section Integers

variable (p : ℕ) [hp : Fact p.Prime] {ι : Type} [Fintype ι] [DecidableEq ι] (K : ι → Type)
  [∀ i, Field (K i)] [∀ i, Algebra ℚ_[p] (K i)] [∀ i, FiniteDimensional ℚ_[p] (K i)]
  [∀ i, Algebra ℤ_[p] (K i)] [∀ i, IsScalarTower ℤ_[p] ℚ_[p] (K i)]

omit [DecidableEq ι] [∀ i, FiniteDimensional ℚ_[p] (K i)] [∀ i, Algebra ℤ_[p] (K i)]
  [∀ i, IsScalarTower ℤ_[p] ℚ_[p] (K i)] in
/-- **Scaling the factors**: `⊗_i (c_i A_i) = (∏_i c_i) · ⊗_i A_i` for `c_i ∈ ℚ_p`. -/
theorem tamSpan_smul (c : ι → ℚ_[p]) (A : ∀ i, Set (K i)) :
    (tamSpan p K (fun i => c i • A i) : Set (PiTensorProduct ℚ_[p] K)) =
      (∏ i, c i) • (tamSpan p K A : Set (PiTensorProduct ℚ_[p] K)) := by
  have h : tamSpan p K (fun i => c i • A i) = (tamSpan p K A).map
      (DistribSMul.toAddMonoidHom (PiTensorProduct ℚ_[p] K) (∏ i, c i)) := by
    rw [tamSpan, tamSpan, AddMonoidHom.map_closure]
    congr 1
    ext w
    constructor
    · rintro ⟨a, y, hy, rfl⟩
      choose x hx hxy using fun i => hy i
      refine ⟨_, ⟨a, x, hx, rfl⟩, ?_⟩
      have hy' : y = fun i => c i • x i := funext fun i => (hxy i).symm
      rw [DistribSMul.toAddMonoidHom_apply, hy', MultilinearMap.map_smul_univ, smul_comm]
      rfl
    · rintro ⟨_, ⟨a, x, hx, rfl⟩, rfl⟩
      refine ⟨a, fun i => c i • x i, fun i => Set.smul_mem_smul_set (hx i), ?_⟩
      rw [DistribSMul.toAddMonoidHom_apply, MultilinearMap.map_smul_univ, smul_comm]
      rfl
  rw [h, AddSubgroup.coe_map]
  exact Set.image_smul

omit [Fintype ι] [∀ i, FiniteDimensional ℚ_[p] (K i)] in
/-- **`R_I` as the image of `⊗_{ℤ_p} R_i`**: for nonempty `I`, `tamSpan` of the rings of
integers is `tdManyIntegers`. -/
theorem tamSpan_integers [Nonempty ι] :
    (tamSpan p K (fun i => (integralClosure ℤ_[p] (K i) : Set (K i))) :
      Set (PiTensorProduct ℚ_[p] K)) = tdManyIntegers p K := by
  obtain ⟨s⟩ := ‹Nonempty ι›
  rw [tamSpan_coe]
  unfold tdManyIntegers
  apply le_antisymm
  · refine AddSubmonoid.closure_le.2 ?_
    rintro _ ⟨a, x, hx, rfl⟩
    rw [← tlsm_tprod_update_smul p K s]
    refine AddSubmonoid.subset_closure ⟨_, fun i => ?_, rfl⟩
    refine (tensorDiff_padicVolIntegral_iff p (K i) _).2 ?_
    by_cases h : i = s
    · subst h
      rw [Function.update_self, ← PadicInt.algebraMap_apply, algebraMap_smul]
      exact (integralClosure ℤ_[p] (K i)).smul_mem (hx i) a
    · rw [Function.update_of_ne h]
      exact hx i
  · refine AddSubmonoid.closure_le.2 ?_
    rintro _ ⟨x, hx, rfl⟩
    refine AddSubmonoid.subset_closure ⟨1, x, fun i => ?_, by simp⟩
    exact (tensorDiff_padicVolIntegral_iff p (K i) _).1 (hx i)

/-- **`p ^ k · (R_I)^∼ ⊆ R_I`** for some `k ∈ ℕ` (nonempty `I`): from Proposition 1.1
(`tdMany_order_mul_mem_integers`, at the maximal ideals) and `tlsm_tprod_mem_normalization`. -/
theorem tam_pow_smul_mem_integers [Nonempty ι] : ∃ k : ℕ,
    ∀ z ∈ packetNormalizationSet p (PiTensorProduct ℚ_[p] K),
      ((p : ℚ_[p]) ^ (k : ℤ)) • z ∈ tdManyIntegers p K := by
  obtain ⟨s⟩ := ‹Nonempty ι›
  have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.out.pos
  have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast hp.out.one_lt.le
  have : ∀ i, IsLocalRing (integralClosure ℤ_[p] (K i)) := fun i =>
    padicBridge_isLocalRing p (K i)
  have : ∀ i, (IsLocalRing.maximalIdeal (integralClosure ℤ_[p] (K i))).LiesOver
      (IsLocalRing.maximalIdeal ℤ_[p]) := fun i => padicBridge_maximalIdeal_liesOver p (K i)
  set P : ∀ i, Ideal (integralClosure ℤ_[p] (K i)) :=
    fun i => IsLocalRing.maximalIdeal (integralClosure ℤ_[p] (K i))
  have : ∀ i, (P i).IsPrime := fun i => Ideal.IsMaximal.isPrime inferInstance
  have hd : ∀ i, ∃ d : K i, d ≠ 0 ∧
      spectralNorm ℚ_[p] (K i) d = (p : ℝ) ^ (-tensorLogDiffOrder p (K i) (P i)) := by
    intro i
    let _ := isDedekindDomain_ringOfIntegers_padic p (K i)
    let _ := isTorsionFree_ringOfIntegers_padic p (K i)
    obtain ⟨d, hd0, hd⟩ := padicBridge_exists_norm_eq_rpow p (K i) (P i)
      (-((differentExponent ℤ_[p] (integralClosure ℤ_[p] (K i)) (P i) : ℕ) : ℤ))
    refine ⟨d, hd0, ?_⟩
    have hd' : spectralNorm ℚ_[p] (K i) d = _ := hd
    rw [hd']
    congr 1
    unfold tensorLogDiffOrder differentOrder
    push_cast
    ring
  choose d hd0 hd using hd
  obtain ⟨k, hk⟩ := exists_nat_ge (tlsmDiffSum p K P)
  refine ⟨k, fun z hz => ?_⟩
  set δ := Function.update d s 1
  have hδs : δ s = 1 := Function.update_self s 1 d
  have hδ0 : ∀ i, δ i ≠ 0 := by
    intro i
    by_cases hi : i = s
    · subst hi
      rw [hδs]
      exact one_ne_zero
    · rw [show δ i = d i from Function.update_of_ne hi 1 d]
      exact hd0 i
  have hδ : ∀ i, i ≠ s → (letI := isDedekindDomain_ringOfIntegers_padic p (K i);
      letI := isTorsionFree_ringOfIntegers_padic p (K i);
      letI := spectralNorm.normedField ℚ_[p] (K i);
      ‖δ i‖ = (p : ℝ) ^ (-differentOrder ℤ_[p] (integralClosure ℤ_[p] (K i)) (P i))) := by
    intro i hi
    show spectralNorm ℚ_[p] (K i) (δ i) = (p : ℝ) ^ (-tensorLogDiffOrder p (K i) (P i))
    rw [show δ i = d i from Function.update_of_ne hi 1 d]
    exact hd i
  set w : ∀ i, K i := fun i => (δ i)⁻¹
  have hws : w s = 1 := by simp [w, hδs]
  set y := Function.update w s (((p : ℚ_[p]) ^ (k : ℤ)) • w s)
  have hy : ∏ i, spectralNorm ℚ_[p] (K i) (y i) ≤ 1 := by
    rw [tlsm_prod_update p K s w _ _ (tlsm_sn_zpow_smul p (K s) _ (w s))]
    have hw : ∏ i, spectralNorm ℚ_[p] (K i) (w i) ≤ (p : ℝ) ^ tlsmDiffSum p K P := by
      rw [tlsmDiffSum, Real.rpow_sum_of_pos hp0]
      refine Finset.prod_le_prod₀ (fun i _ => tlsm_sn_nonneg p (K i) _) fun i _ => ?_
      have hwi : spectralNorm ℚ_[p] (K i) (w i) = (spectralNorm ℚ_[p] (K i) (δ i))⁻¹ := by
        show spectralNorm ℚ_[p] (K i) (δ i)⁻¹ = _
        rw [inv_eq_one_div, tlsm_sn_div, tlsm_sn_one, one_div]
      rw [hwi]
      by_cases hi : i = s
      · subst hi
        rw [hδs, tlsm_sn_one, inv_one]
        exact Real.one_le_rpow hp1 (tensorLogDiffOrder_nonneg p (K i) (P i))
      · rw [show δ i = d i from Function.update_of_ne hi 1 d, hd i, ← Real.rpow_neg hp0.le,
          neg_neg]
    calc (p : ℝ) ^ (-((k : ℤ) : ℝ)) * ∏ i, spectralNorm ℚ_[p] (K i) (w i)
        ≤ (p : ℝ) ^ (-((k : ℤ) : ℝ)) * (p : ℝ) ^ tlsmDiffSum p K P :=
          mul_le_mul_of_nonneg_left hw (by positivity)
      _ = (p : ℝ) ^ (-((k : ℤ) : ℝ) + tlsmDiffSum p K P) := (Real.rpow_add hp0 _ _).symm
      _ ≤ (p : ℝ) ^ (0 : ℝ) := Real.rpow_le_rpow_of_exponent_le hp1 (by push_cast; linarith)
      _ = 1 := Real.rpow_zero _
  have hprod : PiTensorProduct.tprod ℚ_[p] δ * PiTensorProduct.tprod ℚ_[p] y =
      ((p : ℚ_[p]) ^ (k : ℤ)) • (1 : PiTensorProduct ℚ_[p] K) := by
    rw [PiTensorProduct.tprod_mul_tprod]
    have h1 : δ * y =
        Function.update (1 : ∀ i, K i) s (((p : ℚ_[p]) ^ (k : ℤ)) • (1 : ∀ i, K i) s) := by
      funext i
      by_cases hi : i = s
      · subst hi
        simp [y, hδs, hws]
      · rw [Pi.mul_apply, show y i = (δ i)⁻¹ from Function.update_of_ne hi _ w,
          Function.update_of_ne hi, Pi.one_apply]
        exact mul_inv_cancel₀ (hδ0 i)
    rw [h1, tlsm_tprod_update_smul, ← PiTensorProduct.one_def]
  have hmem := tdMany_order_mul_mem_integers p K s P δ hδs hδ
    (tlsm_mul_mem p (tlsm_tprod_mem_normalization p K hy) hz)
  rwa [← mul_assoc, hprod, smul_mul_assoc, one_mul] at hmem

variable [MeasurableSpace (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])]
  [BorelSpace (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])]
  (μ : Measure (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p]))
  [μ.IsAddHaarMeasure]

/-- **`R_I` is open and compact, of positive finite Haar measure**, in the coordinates of
`Module.finBasis` of the packet (nonempty `I`): it is a subgroup containing the open set
`p ^ k · (R_I)^∼` and contained in the compact `(R_I)^∼`. -/
theorem tam_integers_coord [Nonempty ι] :
    IsOpen ((Module.finBasis ℚ_[p] (PiTensorProduct ℚ_[p] K)).equivFun '' tdManyIntegers p K) ∧
      IsCompact ((Module.finBasis ℚ_[p] (PiTensorProduct ℚ_[p] K)).equivFun ''
        tdManyIntegers p K) ∧
      μ ((Module.finBasis ℚ_[p] (PiTensorProduct ℚ_[p] K)).equivFun '' tdManyIntegers p K) ≠ 0 ∧
      μ ((Module.finBasis ℚ_[p] (PiTensorProduct ℚ_[p] K)).equivFun '' tdManyIntegers p K) ≠ ⊤ := by
  set c := (Module.finBasis ℚ_[p] (PiTensorProduct ℚ_[p] K)).equivFun
  obtain ⟨hK, hO, -, -, -, -⟩ := packet_muLog_normalization_tensor p K μ
  obtain ⟨k, hk⟩ := tam_pow_smul_mem_integers p K
  set H := (tamSpan p K (fun i => (integralClosure ℤ_[p] (K i) : Set (K i)))).map
    c.toAddEquiv.toAddMonoidHom
  have hHc : (H : Set (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])) =
      c '' tdManyIntegers p K := by
    rw [AddSubgroup.coe_map, tamSpan_integers]
    rfl
  have hsub : ((p : ℚ_[p]) ^ (k : ℤ)) • (c '' packetNormalizationSet p (PiTensorProduct ℚ_[p] K))
      ⊆ (H : Set _) := by
    rw [hHc, ← padicVol_image_smul p c]
    refine Set.image_mono ?_
    rintro _ ⟨z, hz, rfl⟩
    exact hk z hz
  have hp0 : ((p : ℚ_[p]) ^ (k : ℤ)) ≠ 0 := zpow_ne_zero _ (by exact_mod_cast hp.out.ne_zero)
  have h0 : (0 : Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p]) ∈
      ((p : ℚ_[p]) ^ (k : ℤ)) • (c '' packetNormalizationSet p (PiTensorProduct ℚ_[p] K)) :=
    ⟨0, ⟨0, packet_zero_mem_normalization p _, map_zero c⟩, smul_zero _⟩
  have hHo : IsOpen (H : Set (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])) :=
    AddSubgroup.isOpen_of_mem_nhds _ (Filter.mem_of_superset ((hO.smul₀ hp0).mem_nhds h0) hsub)
  have hHcl := AddSubgroup.isClosed_of_isOpen _ hHo
  rw [hHc] at hHo hHcl
  have hcomp : IsCompact (c '' tdManyIntegers p K) :=
    hK.of_isClosed_subset hHcl (Set.image_mono (tdMany_integers_subset p K))
  refine ⟨hHo, hcomp, hHo.measure_ne_zero μ ⟨0, 0, ?_, map_zero c⟩, hcomp.measure_lt_top.ne⟩
  rw [← tamSpan_integers p K]
  exact zero_mem _

end Integers

/-! ## Identity (A) of page 14 for any finite number of factors -/

section Additivity

variable (p : ℕ) [hp : Fact p.Prime] {ι : Type} [Fintype ι] [DecidableEq ι] (K : ι → Type)
  [∀ i, Field (K i)] [∀ i, Algebra ℚ_[p] (K i)] [∀ i, FiniteDimensional ℚ_[p] (K i)]
  [∀ i, Algebra ℤ_[p] (K i)] [∀ i, IsScalarTower ℤ_[p] ℚ_[p] (K i)]
  [MeasurableSpace (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])]
  [BorelSpace (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])]
  (μ : Measure (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p]))
  [μ.IsAddHaarMeasure]

omit [∀ i, FiniteDimensional ℚ_[p] (K i)] [∀ i, Algebra ℤ_[p] (K i)]
  [∀ i, IsScalarTower ℤ_[p] ℚ_[p] (K i)]
  [MeasurableSpace (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])]
  [BorelSpace (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])] in
/-- `∏_{i ≠ s} d_i · d_s = ∏_i d_i`. -/
theorem tam_degOff_mul (s : ι) :
    (tamDegOff p K s : ℝ) * Module.finrank ℚ_[p] (K s) = ∏ i, (Module.finrank ℚ_[p] (K i) : ℝ) := by
  rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ s), mul_comm, tamDegOff]
  push_cast
  congr 1
  exact (Finset.prod_subtype (Finset.univ.erase s) (fun i => by simp)
    (fun i => (Module.finrank ℚ_[p] (K i) : ℝ))).symm

/-- **Identity (A) for lattices, any finite number of factors** (IUT IV page 14, in general
form): for `ℤ_p`-submodules `L_i ⊆ K_i` with `p ^ (k_i) · R_i ⊆ L_i ⊆ p ^ (−k_i) · R_i`, the image
of `⊗_{i, ℤ_p} L_i` in the packet has positive finite Haar measure in coordinates, and its packet
log-volume (normalized by `μ^log((R_I)^∼) = 0`) is `∑_i μ^log(L_i) + μ^log(R_I)`, with
`μ^log(L_i)` the log-volume of `K_i` normalized by `μ^log(R_i) = 0` (`tensorAddMuLog`). The proof:
`p ^ (∑ k_i) · R_I` is the image of `⊗_i p ^ (k_i) R_i`, its index in the image of `⊗_i L_i` is
`∏_s [L_s : p ^ (k_s) R_s] ^ (∏_{i ≠ s} d_i)` (`tam_relIndex`), and Haar measure multiplies by
the index. -/
theorem tam_muLog_add [Nonempty ι] (L : ∀ i, Submodule ℤ_[p] (K i)) (k : ι → ℕ)
    (hlo : ∀ i, ((p : ℚ_[p]) ^ (k i : ℤ)) • (integralClosure ℤ_[p] (K i) : Set (K i)) ⊆ L i)
    (hhi : ∀ i, (L i : Set (K i)) ⊆
      ((p : ℚ_[p]) ^ (-(k i : ℤ))) • (integralClosure ℤ_[p] (K i) : Set (K i))) :
    μ ((Module.finBasis ℚ_[p] (PiTensorProduct ℚ_[p] K)).equivFun ''
        (tamSpan p K (fun i => (L i : Set (K i))) : Set (PiTensorProduct ℚ_[p] K))) ≠ 0 ∧
      μ ((Module.finBasis ℚ_[p] (PiTensorProduct ℚ_[p] K)).equivFun ''
        (tamSpan p K (fun i => (L i : Set (K i))) : Set (PiTensorProduct ℚ_[p] K))) ≠ ⊤ ∧
      padicPacketMuLog p (PiTensorProduct ℚ_[p] K) μ
          (packetNormalizationSet p (PiTensorProduct ℚ_[p] K))
          (tamSpan p K (fun i => (L i : Set (K i)))) =
        ∑ i, tensorAddMuLog p (K i) (L i) +
          padicPacketMuLog p (PiTensorProduct ℚ_[p] K) μ
            (packetNormalizationSet p (PiTensorProduct ℚ_[p] K)) (tdManyIntegers p K) := by
  have hpq : (p : ℚ_[p]) ≠ 0 := by exact_mod_cast hp.out.ne_zero
  set c := (Module.finBasis ℚ_[p] (PiTensorProduct ℚ_[p] K)).equivFun
  set cm : AddSubgroup (PiTensorProduct ℚ_[p] K) →
      AddSubgroup (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p]) :=
    fun S => S.map c.toAddEquiv.toAddMonoidHom
  have hcm : ∀ S, (cm S : Set (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])) =
      c '' (S : Set (PiTensorProduct ℚ_[p] K)) := fun S => by
    rw [AddSubgroup.coe_map]
    rfl
  have hcmi : ∀ S T, (cm S).relIndex (cm T) = S.relIndex T := fun S T =>
    AddSubgroup.relIndex_map_map_of_injective S T c.toAddEquiv.injective
  set Sc := fun i => tensorAddScaled p (K i) (k i)
  have hC : ∀ i, Sc i ≤ L i := fun i x hx => by
    have hx' : x ∈ (tensorAddScaled p (K i) (k i) : Set (K i)) := hx
    rw [tensorAddScaled_coe] at hx'
    exact hlo i hx'
  have hidx := tam_relIndex p K Sc L hC
    (fun i => tensorAdd_fg_of_subset p (K i) _ (k i : ℤ) (tensorAddScaled_coe p (K i) _).le)
    (fun i => tensorAdd_span_eq_top p (K i) _ (k i : ℤ) (tensorAddScaled_coe p (K i) _).ge)
    (fun i => tensorAdd_fg_of_subset p (K i) (L i) _ (hhi i))
    (fun i => tensorAdd_span_eq_top p (K i) (L i) _ (hlo i))
  have ha : ∀ i, (Sc i).toAddSubgroup.relIndex (L i).toAddSubgroup ≠ 0 := fun i =>
    tensorAdd_one_relIndex_ne_zero p (K i) (L i) (k i) (hlo i) (hhi i)
  have hn : (tamSpan p K (fun i => (Sc i : Set (K i)))).relIndex
      (tamSpan p K (fun i => (L i : Set (K i)))) ≠ 0 := by
    rw [hidx]
    exact Finset.prod_ne_zero_iff.2 fun i _ => pow_ne_zero _ (ha i)
  have hScoe : (tamSpan p K (fun i => (Sc i : Set (K i))) : Set (PiTensorProduct ℚ_[p] K)) =
      ((p : ℚ_[p]) ^ ((∑ i, k i : ℕ) : ℤ)) • tdManyIntegers p K := by
    have h1 : (fun i => (Sc i : Set (K i))) =
        fun i => ((p : ℚ_[p]) ^ (k i : ℤ)) • (integralClosure ℤ_[p] (K i) : Set (K i)) :=
      funext fun i => tensorAddScaled_coe p (K i) _
    rw [h1, tamSpan_smul, tamSpan_integers, tlsm_prod_zpow hpq]
    push_cast
    rfl
  obtain ⟨hRo, -, hR0, hR1⟩ := tam_integers_coord p K μ
  obtain ⟨-, -, hN0, hN1, -, -⟩ := packet_muLog_normalization_tensor p K μ
  have hSo : IsOpen (cm (tamSpan p K (fun i => (Sc i : Set (K i)))) :
      Set (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])) := by
    rw [hcm, hScoe, padicVol_image_smul p]
    exact hRo.smul₀ (zpow_ne_zero _ hpq)
  have hle : cm (tamSpan p K (fun i => (Sc i : Set (K i)))) ≤
      cm (tamSpan p K (fun i => (L i : Set (K i)))) :=
    AddSubgroup.map_mono (tamSpan_mono p K fun i => SetLike.coe_subset_coe.2 (hC i))
  have hne : (cm (tamSpan p K (fun i => (Sc i : Set (K i))))).relIndex
      (cm (tamSpan p K (fun i => (L i : Set (K i))))) ≠ 0 := by
    rw [hcmi]
    exact hn
  have : Finite (↥(cm (tamSpan p K (fun i => (L i : Set (K i))))) ⧸
      (cm (tamSpan p K (fun i => (Sc i : Set (K i))))).addSubgroupOf
        (cm (tamSpan p K (fun i => (L i : Set (K i)))))) :=
    Nat.finite_of_card_ne_zero hne
  have hmeas := tensorIdx_measure_eq_relIndex μ hle hSo.measurableSet
  rw [hcmi, hcm, hcm, hScoe] at hmeas
  have hS0 : μ (c '' (((p : ℚ_[p]) ^ ((∑ i, k i : ℕ) : ℤ)) • tdManyIntegers p K)) ≠ 0 ∧
      μ (c '' (((p : ℚ_[p]) ^ ((∑ i, k i : ℕ) : ℤ)) • tdManyIntegers p K)) ≠ ⊤ := by
    have hpz : (p : ℚ_[p]) ^ ((∑ i, k i : ℕ) : ℤ) ≠ 0 := zpow_ne_zero _ hpq
    rw [padicVol_image_smul p, padicVol_measure_smul p μ hpz]
    refine ⟨mul_ne_zero ?_ hR0, ENNReal.mul_ne_top ENNReal.coe_ne_top hR1⟩
    exact ENNReal.coe_ne_zero.2 (pow_ne_zero _ (nnNorm_ne_zero_iff.2 hpz))
  have hnR : (0 : ENNReal) < ((tamSpan p K (fun i => (Sc i : Set (K i)))).relIndex
      (tamSpan p K (fun i => (L i : Set (K i)))) : ENNReal) := by
    exact_mod_cast Nat.pos_of_ne_zero hn
  refine ⟨?_, ?_, ?_⟩
  · rw [hmeas]
    exact mul_ne_zero hnR.ne' hS0.1
  · rw [hmeas]
    exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top _) hS0.2
  have hD : 0 < Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K) := by
    rw [packet_finrank p K]
    exact Finset.prod_pos fun i _ => Module.finrank_pos
  have h3 := tensorAdd_muLog_of_measure_eq p μ hn hN0 hN1 hS0.1 hS0.2 hmeas
  rw [Module.finrank_fin_fun] at h3
  have h4 := padicPacketMuLog_p_zpow_smul p μ hD hN0 hN1 hR0 hR1 ((∑ i, k i : ℕ) : ℤ)
  unfold padicPacketMuLog at h4 ⊢
  rw [h3, h4, hidx]
  have hd : ∀ i, (0 : ℝ) < Module.finrank ℚ_[p] (K i) := fun i => by
    exact_mod_cast Module.finrank_pos
  have hb : ∀ i, (0 : ℝ) < ((Sc i).toAddSubgroup.relIndex (L i).toAddSubgroup : ℝ) := fun i => by
    exact_mod_cast Nat.pos_of_ne_zero (ha i)
  have hT : ∀ s, (0 : ℝ) < tamDegOff p K s := fun s => by
    rw [tamDegOff]
    push_cast
    exact Finset.prod_pos fun i _ => hd i
  have hlog : Real.log ((∏ s, (Sc s).toAddSubgroup.relIndex (L s).toAddSubgroup ^
      tamDegOff p K s : ℕ) : ℝ) / Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K) =
      ∑ s, Real.log ((Sc s).toAddSubgroup.relIndex (L s).toAddSubgroup) /
        Module.finrank ℚ_[p] (K s) := by
    push_cast
    rw [Real.log_prod (fun s _ => (pow_pos (hb s) _).ne'), Finset.sum_div,
      packet_finrank]
    refine Finset.sum_congr rfl fun s _ => ?_
    push_cast
    rw [Real.log_pow, ← tam_degOff_mul p K s]
    field_simp [(hT s).ne', (hd s).ne']
  rw [hlog]
  simp only [Sc] at *
  rw [Finset.sum_congr rfl fun i _ => tensorAddMuLog_eq p (K i) (L i) (k i) (hlo i) (hhi i)]
  rw [Finset.sum_add_distrib, Finset.sum_neg_distrib, ← Finset.sum_mul]
  push_cast
  ring

end Additivity

/-! ## Identity (A) for `log_p(R_I^×)`; Proposition 1.4 (ii) and (iii) for `n` factors -/

section LogVolume

variable (p : ℕ) [hp : Fact p.Prime] {ι : Type} [Fintype ι] [DecidableEq ι] (K : ι → Type)
  [∀ i, Field (K i)] [∀ i, Algebra ℚ_[p] (K i)] [∀ i, FiniteDimensional ℚ_[p] (K i)]
  [∀ i, Algebra ℤ_[p] (K i)] [∀ i, IsScalarTower ℤ_[p] ℚ_[p] (K i)]
  [MeasurableSpace (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])]
  [BorelSpace (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])]
  (μ : Measure (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p]))
  [μ.IsAddHaarMeasure]

omit [Fintype ι] [DecidableEq ι] [∀ i, IsScalarTower ℤ_[p] ℚ_[p] (K i)]
  [MeasurableSpace (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])]
  [BorelSpace (Fin (Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K)) → ℚ_[p])] in
/-- `tlsmLattice` (`log_p(R_I^×)`) is the image of `⊗_{i, ℤ_p} log_p(R_i^×)` in the sense of
`tamSpan`. -/
theorem tamSpan_logUnits :
    (tamSpan p K (fun i => tensorLogUnits p (K i)) : Set (PiTensorProduct ℚ_[p] K)) =
      tlsmLattice p K :=
  tamSpan_coe p K _

/-- **Identity (A) of IUT IV page 14 for any finite number of factors**:
`μ^log(log_p(R_I^×)) = ∑_i μ^log(log_p(R_i^×)) + μ^log(R_I)`, where `log_p(R_I^×)` is
`tlsmLattice`, `R_I` is `tdManyIntegers`, the left side and the last term are packet log-volumes
normalized by `μ^log((R_I)^∼) = 0`, and `μ^log(log_p(R_i^×))` is the log-volume of `K_i`
normalized by `μ^log(R_i) = 0` (`tensorAddMuLog`). Also: `log_p(R_I^×)` has positive finite
Haar measure in coordinates. -/
theorem tam_muLog_logLattice [Nonempty ι] :
    μ ((Module.finBasis ℚ_[p] (PiTensorProduct ℚ_[p] K)).equivFun '' tlsmLattice p K) ≠ 0 ∧
      μ ((Module.finBasis ℚ_[p] (PiTensorProduct ℚ_[p] K)).equivFun '' tlsmLattice p K) ≠ ⊤ ∧
      padicPacketMuLog p (PiTensorProduct ℚ_[p] K) μ
          (packetNormalizationSet p (PiTensorProduct ℚ_[p] K)) (tlsmLattice p K) =
        ∑ i, tensorAddMuLog p (K i) (tensorLogUnits p (K i)) +
          padicPacketMuLog p (PiTensorProduct ℚ_[p] K) μ
            (packetNormalizationSet p (PiTensorProduct ℚ_[p] K)) (tdManyIntegers p K) := by
  choose k hk hk' using fun i => tensorAdd_logUnits_sandwich p (K i)
  rw [← tamSpan_logUnits]
  exact tam_muLog_add p K μ (fun i => tensorAddLogSubmodule p (K i)) k hk hk'

/-- **IUT IV Proposition 1.4 (ii), combined with (A), for any finite number of factors**
(page 13): `μ^log(log_p(R_I^×)) = −∑_i (1 / e_i + m_i / (e_i f_i)) log(p) + μ^log(R_I)`. -/
theorem tam_prop1_4_ii [Nonempty ι]
    (P : ∀ i, Ideal (integralClosure ℤ_[p] (K i))) [∀ i, (P i).IsPrime]
    [∀ i, (P i).LiesOver (IsLocalRing.maximalIdeal ℤ_[p])] :
    padicPacketMuLog p (PiTensorProduct ℚ_[p] K) μ
        (packetNormalizationSet p (PiTensorProduct ℚ_[p] K)) (tlsmLattice p K) =
      ∑ i, -(1 / ((P i).ramificationIdx ℤ_[p] : ℝ) +
          (unitVolTorsionExponent p (K i) : ℝ) /
            (((P i).ramificationIdx ℤ_[p] : ℝ) * unitVolResidueDegree p (K i))) * Real.log p +
        padicPacketMuLog p (PiTensorProduct ℚ_[p] K) μ
          (packetNormalizationSet p (PiTensorProduct ℚ_[p] K)) (tdManyIntegers p K) := by
  rw [(tam_muLog_logLattice p K μ).2.2]
  congr 1
  exact Finset.sum_congr rfl fun i _ => tensorAddMuLog_logUnits p (K i) (P i)

/-- **IUT IV Proposition 1.4 (iii), first inequality, for any finite number of factors**
(page 13, proof on page 14). Let `I* ⊆ I` be such that `e_i ≤ p − 2` for `i ∉ I*`. For every
real `λ`: `μ^log(p ^ ⌊λ − 𝔡_I − a_I⌋ · log_p(R_I^×)) ≤ (−λ + 𝔡_I + 1 + 4 |I*| / p) log(p)`, the
packet log-volume normalized by `μ^log((R_I)^∼) = 0`. The proof follows page 14: the floor step,
identity (A) (`tam_muLog_logLattice`), `μ^log(log_p(R_i^×)) ≤ −(1 / e_i) log(p)` from
Proposition 1.4 (ii), `μ^log(R_I) ≤ 0`, and `Proposition1_4.iii_first`. -/
theorem tam_prop1_4_iii_first [Nonempty ι]
    (P : ∀ i, Ideal (integralClosure ℤ_[p] (K i))) [∀ i, (P i).IsPrime]
    [∀ i, (P i).LiesOver (IsLocalRing.maximalIdeal ℤ_[p])]
    (Istar : Finset ι) (hIstar : ∀ i, i ∉ Istar → (P i).ramificationIdx ℤ_[p] ≤ p - 2)
    (lam : ℝ) :
    padicPacketMuLog p (PiTensorProduct ℚ_[p] K) μ
        (packetNormalizationSet p (PiTensorProduct ℚ_[p] K))
        (((p : ℚ_[p]) ^ ⌊lam - tlsmDiffSum p K P - tlsmASum p K P⌋) • tlsmLattice p K) ≤
      (-lam + tlsmDiffSum p K P + 1 + 4 * Istar.card / p) * Real.log p := by
  obtain ⟨h0, h1, hA⟩ := tam_muLog_logLattice p K μ
  obtain ⟨-, -, hN0, hN1, -, -⟩ := packet_muLog_normalization_tensor p K μ
  have hD : 0 < Module.finrank ℚ_[p] (PiTensorProduct ℚ_[p] K) := by
    rw [packet_finrank p K]
    exact Finset.prod_pos fun i _ => Module.finrank_pos
  have hf := packet_muLog_floor_smul_le p (PiTensorProduct ℚ_[p] K) μ hD hN0 hN1 h0 h1
    (lam - tlsmDiffSum p K P - tlsmASum p K P)
  have hmu : ∀ i ∈ (Finset.univ : Finset ι), tensorAddMuLog p (K i) (tensorLogUnits p (K i)) ≤
      -(1 / ((P i).ramificationIdx ℤ_[p] : ℝ)) * Real.log p := by
    intro i _
    have hL : 0 < Real.log p := Real.log_pos (by exact_mod_cast hp.out.one_lt)
    rw [tensorAddMuLog_logUnits p (K i) (P i)]
    have : 0 ≤ (unitVolTorsionExponent p (K i) : ℝ) /
        (((P i).ramificationIdx ℤ_[p] : ℝ) * unitVolResidueDegree p (K i)) := by positivity
    nlinarith
  refine Proposition1_4.iii_first hp.out.two_le Finset.univ Istar (Finset.subset_univ _)
    (fun i => (P i).ramificationIdx ℤ_[p]) (fun i => tensorLog_one_le_ramificationIdx p (K i) (P i))
    (fun i _ hi => hIstar i hi) (fun i => tensorAddMuLog p (K i) (tensorLogUnits p (K i)))
    (dI := tlsmDiffSum p K P) ?_ hA hmu
    (tlsm_muLog_le_zero p K μ (tdMany_integers_subset p K))
  refine hf.trans_eq ?_
  rw [tlsmASum]
  ring

end LogVolume

