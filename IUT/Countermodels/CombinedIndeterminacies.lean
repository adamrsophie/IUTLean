import Mathlib

/-!
# Countermodels: separate indeterminacies versus their combined action

Source context: Mochizuki, *Inter-universal Teichmüller Theory III*, read for this file from
the extracted text: Theorem 3.11 (i), (ii), pages 153 to 157 (the indeterminacies (Ind1),
(Ind2), (Ind3)); the statement of Corollary 3.12, pages 173 and 174, where `− |log(Θ)|` is the
log-volume of the holomorphic hull of the union of the possible images of a Θ-pilot object
subject to (Ind1), (Ind2), (Ind3); and Step (x) of its proof, page 181, which states that the
procession-normalized log-volumes are invariant with respect to (Ind1) and (Ind2) and convert
(Ind3) into an inequality. No formula of the papers is transcribed here.

**None of the statements below is a counterexample to a statement of the IUT papers.** They
separate two principles that are easy to conflate:

* for a single-valued quantity, invariance under each of several transformations gives
  invariance under every transformation they generate (`invariant_closure`, positive; the
  two-step case is `IUT.Countermodels.invariant_comp` in `Basic.lean`);
* for a set-valued construction such as "the union of the possible images", the union of the
  images under each indeterminacy separately can be much smaller than the union under their
  combined action (`separate_finite_joint_infinite`, countermodel).

In the countermodel each of the two indeterminacies is a reflection of the real line, a group of
order `2`, and the union of the images of the unit interval under either one separately has
volume at most `3`. The two reflections together generate the infinite dihedral group, which
contains all translations by even integers, and the union of the images under it has infinite
volume. So a bound on the volume of the union of possible images must be established for the
combined action. The example concerns volumes of unions, not the log-volumes of regions in the
papers, which Step (x) on page 181 states to be invariant under (Ind1) and (Ind2).
-/

namespace IUT.Countermodels.Indet

open MeasureTheory Set

/-! ## The positive statements -/

/-- **Positive statement.** A set mapped onto itself by each of two permutations is mapped onto
itself by every element of the group they generate. -/
theorem invariant_set_closure {α : Type*} (g h : Equiv.Perm α) (T : Set α)
    (hg : g '' T = T) (hh : h '' T = T) :
    ∀ σ ∈ Subgroup.closure ({g, h} : Set (Equiv.Perm α)), σ '' T = T := by
  intro σ hσ
  induction hσ using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact hg
    · exact hh
  | one => simp
  | mul x y _ _ hx hy => rw [Equiv.Perm.coe_mul, image_comp, hy, hx]
  | inv x _ hx =>
    rw [Equiv.Perm.inv_def]
    conv_lhs => rw [← hx]
    exact x.symm_image_image T

/-- **Positive statement.** A function invariant under each of two permutations is invariant
under every element of the group they generate. This extends
`IUT.Countermodels.invariant_comp` of `Basic.lean` from one composite to the whole group. -/
theorem invariant_closure {α β : Type*} (F : α → β) (g h : Equiv.Perm α)
    (hg : ∀ x, F (g x) = F x) (hh : ∀ x, F (h x) = F x) :
    ∀ σ ∈ Subgroup.closure ({g, h} : Set (Equiv.Perm α)), ∀ x, F (σ x) = F x := by
  intro σ hσ
  induction hσ using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact hg
    · exact hh
  | one => simp
  | mul x y _ _ hx hy => intro z; rw [Equiv.Perm.mul_apply, hx, hy]
  | inv x _ hx =>
    intro z
    rw [← hx (x⁻¹ z), Equiv.Perm.inv_def, Equiv.apply_symm_apply]

/-! ## The countermodel -/

/-- The reflection `x ↦ −x` of the real line. -/
def reflect0 : Equiv.Perm ℝ := Equiv.neg ℝ

/-- The reflection `x ↦ 2 − x` of the real line. -/
def reflect1 : Equiv.Perm ℝ := Equiv.subLeft 2

/-- The composite of the two reflections is the translation by `2`; its powers are the
translations by even integers. -/
theorem pow_reflect_apply (k : ℕ) (y : ℝ) : ((reflect1 * reflect0) ^ k) y = y + 2 * k := by
  induction k generalizing y with
  | zero => simp
  | succ k ih =>
    rw [pow_succ, Equiv.Perm.mul_apply, ih]
    simp [reflect0, reflect1, Equiv.subLeft]
    ring

/-- **Countermodel.** Let `S = [0, 1]`, `g x = −x`, `h x = 2 − x`. Both preserve Lebesgue
measure, `S` is compact of volume `1`, and each of `g`, `h` is an involution, so the orbit of `S` under each indeterminacy separately is `S ∪ g S`, respectively
`S ∪ h S`, and the union of all images under the indeterminacies taken separately has volume at
most `3`. The union of the images of `S` under the group generated by `g` and `h` together has
infinite volume. -/
theorem separate_finite_joint_infinite :
    MeasurePreserving reflect0 volume volume ∧ MeasurePreserving reflect1 volume volume ∧
      IsCompact (Icc (0 : ℝ) 1) ∧ volume (Icc (0 : ℝ) 1) = 1 ∧
      reflect0 * reflect0 = 1 ∧ reflect1 * reflect1 = 1 ∧
      volume (Icc (0 : ℝ) 1 ∪ reflect0 '' Icc 0 1 ∪ reflect1 '' Icc 0 1) ≤ 3 ∧
      volume (⋃ σ ∈ Subgroup.closure ({reflect1, reflect0} : Set (Equiv.Perm ℝ)),
        σ '' Icc (0 : ℝ) 1) = ⊤ := by
  refine ⟨?_, ?_, isCompact_Icc, by simp [Real.volume_Icc], ?_, ?_, ?_, ?_⟩
  · exact Measure.measurePreserving_neg volume
  · exact Measure.measurePreserving_sub_left volume 2
  · ext x; simp [reflect0]
  · ext x; simp [reflect1, Equiv.subLeft]
  · calc volume (Icc (0 : ℝ) 1 ∪ reflect0 '' Icc 0 1 ∪ reflect1 '' Icc 0 1)
          ≤ volume (Icc (-1 : ℝ) 2) := by
            apply measure_mono
            rintro x ((hx | ⟨y, hy, rfl⟩) | ⟨y, hy, rfl⟩)
            · exact ⟨by linarith [hx.1], by linarith [hx.2]⟩
            · simp only [reflect0, Equiv.neg_apply]
              exact ⟨by linarith [hy.2], by linarith [hy.1]⟩
            · simp only [reflect1, Equiv.subLeft_apply]
              exact ⟨by linarith [hy.2], by linarith [hy.1]⟩
        _ = 3 := by rw [Real.volume_Icc]; norm_num
  · apply eq_top_iff.mpr
    rw [← Real.volume_Ici (a := 0)]
    apply measure_mono
    intro x hx
    have hx0 : (0 : ℝ) ≤ x := hx
    set k := ⌊x / 2⌋₊ with hk
    have hlo : 2 * (k : ℝ) ≤ x := by
      have := Nat.floor_le (by linarith : 0 ≤ x / 2)
      rw [← hk] at this
      linarith
    have hhi : x < 2 * (k : ℝ) + 2 := by
      have := Nat.lt_floor_add_one (x / 2)
      rw [← hk] at this
      linarith
    set t := (reflect1 * reflect0) ^ k
    have ht : t ∈ Subgroup.closure ({reflect1, reflect0} : Set (Equiv.Perm ℝ)) :=
      Subgroup.pow_mem _ (Subgroup.mul_mem _ (Subgroup.subset_closure (by simp))
        (Subgroup.subset_closure (by simp))) k
    rcases le_or_gt (x - 2 * k) 1 with h1 | h1
    · refine mem_iUnion₂.mpr ⟨t, ht, x - 2 * k, ⟨by linarith, h1⟩, ?_⟩
      rw [pow_reflect_apply]
      ring
    · have hth : t * reflect1 ∈ Subgroup.closure ({reflect1, reflect0} : Set (Equiv.Perm ℝ)) :=
        Subgroup.mul_mem _ ht (Subgroup.subset_closure (by simp))
      refine mem_iUnion₂.mpr ⟨t * reflect1, hth, 2 - (x - 2 * k), ⟨by linarith, by linarith⟩, ?_⟩
      rw [Equiv.Perm.mul_apply, pow_reflect_apply]
      simp only [reflect1, Equiv.subLeft_apply]
      ring

end IUT.Countermodels.Indet
