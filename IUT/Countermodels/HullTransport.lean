import Mathlib

/-!
# Countermodels: hull formation and transport

Source context: Mochizuki, *Inter-universal Teichmüller Theory III*, read for this file from
the extracted text: the statement of Corollary 3.12 (pages 173 and 174, "holomorphic hull" of
the union of the possible images) and Steps (xi-c), (xi-d) of its proof (pages 182 and 183),
where the output data of the multiradial algorithm, expressed in tensor packets of
mono-analytic log-shells, is enlarged to its holomorphic hull relative to the arithmetic
holomorphic structure labeled `1, ◦`, so as to be expressed through localizations of
arithmetic vector bundles over the rings `𝒪_{K_v}`. Remark 3.9.5, where the hull is defined,
was not read; this file refers to the hull only through the pages above. No formula of the
papers is transcribed here.

**None of the statements below is a counterexample to a statement of the IUT papers.** They
refute the simplified abstraction "forming a hull commutes with transport", when the hull is
taken with respect to more structure than the transport map preserves. Two hulls are used, both
from Mathlib: the `ℂ`-linear span (a stand-in for a hull relative to a holomorphic structure,
transported along a map that is only `ℝ`-linear, that is, mono-analytic), and the
`ℤ[i]`-submodule generated by a set (an integral hull, an `𝒪`-submodule, transported along a map
that is only `ℤ`-linear). `IUT.Countermodels.hull_transport_not_commute` in `Basic.lean` is the
finite toy version with an order hull.

The positive statement `hull_transport_semilinear` records the valid principle: hull formation
commutes with every map that preserves the structure the hull uses, up to a surjective ring map
on the scalars.
-/

namespace IUT.Countermodels.Hull

open Complex ComplexConjugate

/-! ## A holomorphic hull and a mono-analytic transport -/

/-- The map `(z, w) ↦ (z, conj w)` on `ℂ²`. It is `ℝ`-linear and bijective, but it is neither
`ℂ`-linear nor conjugate-linear. -/
def halfConj (x : ℂ × ℂ) : ℂ × ℂ := (x.1, conj x.2)

/-- **Countermodel.** `halfConj` is bijective, additive, and commutes with real scalars, but the image of the
`ℂ`-line spanned by `(1, 1)` is not the `ℂ`-line spanned by the image of `(1, 1)`: the point
`(i, −i)` lies in the first set and not in the second. So the hull relative to the complex
structure of the transported set differs from the transport of the hull. -/
theorem halfConj_countermodel :
    Function.Bijective halfConj ∧ (∀ x y, halfConj (x + y) = halfConj x + halfConj y) ∧
      (∀ (r : ℝ) x, halfConj ((r : ℂ) • x) = (r : ℂ) • halfConj x) ∧
      halfConj '' (Submodule.span ℂ {((1 : ℂ), (1 : ℂ))} : Set (ℂ × ℂ)) ≠
        (Submodule.span ℂ (halfConj '' {((1 : ℂ), (1 : ℂ))}) : Set (ℂ × ℂ)) := by
  refine ⟨Function.Involutive.bijective fun x => by simp [halfConj], fun x y => by simp [halfConj],
    fun r x => by simp [halfConj, conj_ofReal], ?_⟩
  intro h
  have hmem : (I, -I) ∈ halfConj '' (Submodule.span ℂ {((1 : ℂ), (1 : ℂ))} : Set (ℂ × ℂ)) :=
    ⟨(I, I), Submodule.mem_span_singleton.mpr ⟨I, by simp⟩, by simp [halfConj, conj_I]⟩
  rw [h, Set.image_singleton] at hmem
  have himg : halfConj ((1 : ℂ), (1 : ℂ)) = (1, 1) := by simp [halfConj]
  rw [himg, SetLike.mem_coe, Submodule.mem_span_singleton] at hmem
  obtain ⟨c, hc⟩ := hmem
  have h1 : c = I := by simpa using congrArg Prod.fst hc
  have h2 : c = -I := by simpa using congrArg Prod.snd hc
  have : (I : ℂ) = 0 := by
    have : I = -I := h1.symm.trans h2
    linear_combination this / 2
  exact I_ne_zero this

/-! ## An integral hull and a `ℤ`-linear transport -/

/-- The shear `a + b i ↦ (a + b) + b i` of the Gaussian integers: a `ℤ`-linear bijection that is
not `ℤ[i]`-linear. -/
def shear (z : GaussianInt) : GaussianInt := ⟨z.re + z.im, z.im⟩

/-- **Countermodel.** The shear is additive and bijective. The image under the shear of the
`ℤ[i]`-submodule generated by `1 + i` (an ideal of index `2`) is not the `ℤ[i]`-submodule
generated by the image `2 + i` (an ideal of norm `5`): the element `2 = (1 − i)(1 + i)` is fixed
by the shear, but `2` is not a multiple of `2 + i`, since `5` does not divide the norm `4`
of `2`. So the integral hull of the transported set differs from the transport of the integral
hull. -/
theorem shear_countermodel :
    (∀ x y, shear (x + y) = shear x + shear y) ∧ Function.Bijective shear ∧
      shear '' (Submodule.span GaussianInt {(⟨1, 1⟩ : GaussianInt)} : Set GaussianInt) ≠
        (Submodule.span GaussianInt (shear '' {(⟨1, 1⟩ : GaussianInt)}) : Set GaussianInt) := by
  refine ⟨fun x y => by ext <;> simp [shear]; ring, ⟨?_, ?_⟩, ?_⟩
  · intro x y hxy
    have h1 := congrArg Zsqrtd.re hxy
    have h2 := congrArg Zsqrtd.im hxy
    simp only [shear] at h1 h2
    ext <;> omega
  · intro y
    exact ⟨⟨y.re - y.im, y.im⟩, by ext <;> simp [shear]⟩
  · intro h
    have hmem : (2 : GaussianInt) ∈
        shear '' (Submodule.span GaussianInt {(⟨1, 1⟩ : GaussianInt)} : Set GaussianInt) := by
      refine ⟨2, Submodule.mem_span_singleton.mpr ⟨⟨1, -1⟩, ?_⟩, ?_⟩
      · ext <;> simp
      · ext <;> simp [shear]
    rw [h, Set.image_singleton, SetLike.mem_coe, Submodule.mem_span_singleton] at hmem
    obtain ⟨c, hc⟩ := hmem
    have hn := congrArg Zsqrtd.norm hc
    rw [smul_eq_mul, Zsqrtd.norm_mul] at hn
    have h5 : Zsqrtd.norm (shear ⟨1, 1⟩ : GaussianInt) = 5 := by
      simp [shear, Zsqrtd.norm]
    have h4 : Zsqrtd.norm (2 : GaussianInt) = 4 := by rfl
    rw [h5, h4] at hn
    omega

/-! ## The positive statement -/

/-- **Positive statement.** Hull formation commutes with transport along any map that preserves
the structure used by the hull, up to a surjective ring map `σ` on the scalars: for a
`σ`-semilinear map `f`, the image of the `R`-span of `s` is the `R₂`-span of the image of `s`
(`Submodule.map_span`). In particular complex conjugation applied to both coordinates of `ℂ²`
does commute with the complex hull; `halfConj` fails because it is conjugate-linear on one
coordinate and linear on the other. The analog for convex hulls and affine maps is
`AffineMap.image_convexHull`. -/
theorem hull_transport_semilinear {R R₂ M M₂ : Type*} [Semiring R] [Semiring R₂]
    [AddCommMonoid M] [AddCommMonoid M₂] [Module R M] [Module R₂ M₂] {σ : R →+* R₂}
    [RingHomSurjective σ] (f : M →ₛₗ[σ] M₂) (s : Set M) :
    (Submodule.span R s).map f = Submodule.span R₂ (f '' s) :=
  Submodule.map_span f s

end IUT.Countermodels.Hull
